<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_asset" model="ir.sequence">
        <field name="name">ZENLENET 资产编码</field>
        <field name="code">zenlenet.asset</field>
        <field name="prefix">AS</field>
        <field name="padding">6</field>
    </record>
    <record id="seq_asset_task" model="ir.sequence">
        <field name="name">ZENLENET 资产任务</field>
        <field name="code">zenlenet.asset.task</field>
        <field name="prefix">AT</field>
        <field name="padding">5</field>
    </record>
    <record id="seq_purchase_device" model="ir.sequence">
        <field name="name">ZENLENET 采购设备</field>
        <field name="code">zenlenet.purchase.device</field>
        <field name="prefix">PD</field>
        <field name="padding">6</field>
    </record>
    <record id="seq_maintenance" model="ir.sequence">
        <field name="name">ZENLENET 割接维护</field>
        <field name="code">zenlenet.maintenance</field>
        <field name="prefix">ZL-</field>
        <field name="padding">4</field>
        <field name="number_next">1001</field>
    </record>
    <record id="netbox_url" model="ir.config_parameter">
        <field name="key">zenlenet.netbox_url</field>
        <field name="value">https://netbox.zenlenet.com</field>
    </record>
</odoo>
