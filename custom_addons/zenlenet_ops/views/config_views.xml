<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_zenlenet" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.zenlenet</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="5"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="系统设置" string="系统设置" name="zenlenet_ops" logo="/zenlenet_ops/static/description/icon.png">
                    <block title="公司资料" name="zenlenet_company">
                        <setting id="zenlenet_company_setting" string="抬头信息">
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="zenlenet_brand" class="col-lg-4 o_light_label"/>
                                    <field name="zenlenet_brand"/>
                                </div>
                                <div class="row">
                                    <label for="zenlenet_company_name" class="col-lg-4 o_light_label"/>
                                    <field name="zenlenet_company_name"/>
                                </div>
                                <div class="row">
                                    <label for="zenlenet_company_vat" class="col-lg-4 o_light_label"/>
                                    <field name="zenlenet_company_vat"/>
                                </div>
                                <div class="row">
                                    <label for="zenlenet_company_street" class="col-lg-4 o_light_label"/>
                                    <field name="zenlenet_company_street"/>
                                </div>
                                <div class="row">
                                    <label for="zenlenet_company_email" class="col-lg-4 o_light_label"/>
                                    <field name="zenlenet_company_email"/>
                                </div>
                                <div class="row">
                                    <label for="zenlenet_company_phone" class="col-lg-4 o_light_label"/>
                                    <field name="zenlenet_company_phone"/>
                                </div>
                                <div class="row">
                                    <label for="zenlenet_currency_id" class="col-lg-4 o_light_label"/>
                                    <field name="zenlenet_currency_id" readonly="1"/>
                                </div>
                            </div>
                        </setting>
                        <setting id="zenlenet_logo_setting" string="Logo">
                            <field name="zenlenet_company_logo" widget="image" class="oe_avatar" options="{'size': [0, 80]}"/>
                        </setting>
                    </block>

                    <block title="出账与收款" name="zenlenet_billing">
                        <setting id="zenlenet_auto_billing_setting" string="自动出账">
                            <field name="zenlenet_auto_billing"/>
                            <div class="content-group" invisible="not zenlenet_auto_billing">
                                <div class="row mt8">
                                    <label for="zenlenet_billing_day" class="col-lg-5 o_light_label"/>
                                    <field name="zenlenet_billing_day" class="col-lg-3"/>
                                </div>
                                <div class="row">
                                    <label for="zenlenet_due_days" class="col-lg-5 o_light_label"/>
                                    <field name="zenlenet_due_days" class="col-lg-3"/>
                                </div>
                            </div>
                            <div class="mt8">
                                <button name="action_open_crons" type="object" string="查看定时任务" icon="oi-arrow-right" class="btn-link"/>
                            </div>
                        </setting>
                        <setting id="zenlenet_invoice_footer_setting" string="账单备注">
                            <field name="zenlenet_invoice_footer"/>
                        </setting>
                    </block>

                    <block title="95 值计费" name="zenlenet_usage">
                        <setting id="zenlenet_usage_setting" string="Cacti 接口">
                            <div class="row mt8">
                                <label for="zenlenet_usage_token" class="col-lg-4 o_light_label"/>
                                <field name="zenlenet_usage_token" password="True"/>
                            </div>
                        </setting>
                    </block>

                    <block title="币种" name="zenlenet_currency">
                        <setting id="zenlenet_currency_setting" string="可用币种">
                            <field name="zenlenet_currency_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <div class="mt8" invisible="not zenlenet_rate_pulled">
                                <label for="zenlenet_rate_pulled" class="o_light_label"/>
                                <field name="zenlenet_rate_pulled" readonly="1" class="w-auto"/>
                            </div>
                            <div class="mt8">
                                <button name="action_pull_rates" type="object" string="拉取汇率" icon="oi-arrow-right" class="btn-link"/>
                                <button name="action_open_currencies" type="object" string="维护汇率" icon="oi-arrow-right" class="btn-link"/>
                            </div>
                        </setting>
                    </block>

                    <block title="合同" name="zenlenet_contract">
                        <setting id="zenlenet_contract_term_setting" string="默认期限与续签">
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="zenlenet_contract_term" class="col-lg-5 o_light_label"/>
                                    <field name="zenlenet_contract_term" class="col-lg-3"/>
                                </div>
                                <div class="row">
                                    <label for="zenlenet_auto_renew" class="col-lg-5 o_light_label"/>
                                    <field name="zenlenet_auto_renew" class="col-lg-3"/>
                                </div>
                            </div>
                        </setting>
                        <setting id="zenlenet_notice_setting" string="到期提醒">
                            <div class="row mt8">
                                <label for="zenlenet_notice_days" class="col-lg-5 o_light_label"/>
                                <field name="zenlenet_notice_days" class="col-lg-3"/>
                            </div>
                        </setting>
                    </block>

                    <block title="故障减免" name="zenlenet_credit">
                        <setting id="zenlenet_credit_setting" string="默认减免规则">
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="zenlenet_credit_rate" class="col-lg-5 o_light_label"/>
                                    <field name="zenlenet_credit_rate" class="col-lg-3"/>
                                </div>
                                <div class="row">
                                    <label for="zenlenet_credit_cap" class="col-lg-5 o_light_label"/>
                                    <field name="zenlenet_credit_cap" class="col-lg-3"/>
                                </div>
                            </div>
                        </setting>
                    </block>

                    <block title="工单 SLA" name="zenlenet_sla">
                        <setting id="zenlenet_sla_setting" string="解决时限">
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="zenlenet_sla_urgent" class="col-lg-5 o_light_label"/>
                                    <field name="zenlenet_sla_urgent" class="col-lg-3"/>
                                </div>
                                <div class="row">
                                    <label for="zenlenet_sla_high" class="col-lg-5 o_light_label"/>
                                    <field name="zenlenet_sla_high" class="col-lg-3"/>
                                </div>
                                <div class="row">
                                    <label for="zenlenet_sla_normal" class="col-lg-5 o_light_label"/>
                                    <field name="zenlenet_sla_normal" class="col-lg-3"/>
                                </div>
                                <div class="row">
                                    <label for="zenlenet_sla_low" class="col-lg-5 o_light_label"/>
                                    <field name="zenlenet_sla_low" class="col-lg-3"/>
                                </div>
                            </div>
                        </setting>
                    </block>

                    <block title="账号与权限" name="zenlenet_users">
                        <setting id="zenlenet_users_setting" string="账号">
                            <span class="fa fa-lg fa-users me-2"/>
                            <field name="zenlenet_user_count" class="w-auto fw-bold"/>
                            <span class="o_form_label">个内部账号</span>
                            <div class="mt8">
                                <button name="action_open_users" type="object" string="管理账号" icon="oi-arrow-right" class="btn-link"/>
                            </div>
                        </setting>
                        <setting id="zenlenet_manager_setting" string="岗位与权限">
                            <div class="mt8">
                                <button name="action_open_groups" type="object" string="查看运营主管" icon="oi-arrow-right" class="btn-link"/>
                            </div>
                        </setting>
                    </block>

                    <block title="产品与资源目录" name="zenlenet_catalog">
                        <setting id="zenlenet_products_setting" string="业务与价目">
                            <span class="fa fa-lg fa-tags me-2"/>
                            <field name="zenlenet_product_count" class="w-auto fw-bold"/>
                            <span class="o_form_label">种业务</span>
                            <div class="mt8">
                                <button name="action_open_products" type="object" string="维护业务与价目" icon="oi-arrow-right" class="btn-link"/>
                            </div>
                        </setting>
                        <setting id="zenlenet_datacenter_setting" string="数据中心">
                            <span class="fa fa-lg fa-building me-2"/>
                            <field name="zenlenet_datacenter_count" class="w-auto fw-bold"/>
                            <span class="o_form_label">个数据中心</span>
                            <div class="mt8">
                                <button name="action_open_datacenters" type="object" string="维护数据中心" icon="oi-arrow-right" class="btn-link"/>
                            </div>
                        </setting>
                        <setting id="zenlenet_templates_setting" string="通知模板">
                            <span class="fa fa-lg fa-envelope-o me-2"/>
                            <field name="zenlenet_template_count" class="w-auto fw-bold"/>
                            <span class="o_form_label">个模板</span>
                            <div class="mt8">
                                <button name="action_open_templates" type="object" string="编辑模板" icon="oi-arrow-right" class="btn-link"/>
                            </div>
                        </setting>
                    </block>

                    <block title="登录与集成" name="zenlenet_integration">
                        <setting id="zenlenet_sso_setting" string="Office 365 登录">
                            <field name="zenlenet_sso_enabled"/>
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="zenlenet_sso_client_id" class="col-lg-4 o_light_label"/>
                                    <field name="zenlenet_sso_client_id"/>
                                </div>
                                <div class="row">
                                    <label for="zenlenet_sso_tenant" class="col-lg-4 o_light_label"/>
                                    <field name="zenlenet_sso_tenant"/>
                                </div>
                            </div>
                        </setting>
                        <setting id="zenlenet_netbox_setting" string="NetBox">
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="zenlenet_netbox_url" class="col-lg-4 o_light_label"/>
                                    <field name="zenlenet_netbox_url"/>
                                </div>
                                <div class="row">
                                    <label for="zenlenet_netbox_api_url" class="col-lg-4 o_light_label"/>
                                    <field name="zenlenet_netbox_api_url"/>
                                </div>
                                <div class="row">
                                    <label for="zenlenet_netbox_host" class="col-lg-4 o_light_label"/>
                                    <field name="zenlenet_netbox_host"/>
                                </div>
                                <div class="row">
                                    <label for="zenlenet_netbox_token" class="col-lg-4 o_light_label"/>
                                    <field name="zenlenet_netbox_token" password="True"/>
                                </div>
                                <div class="row">
                                    <label for="zenlenet_netbox_sync" class="col-lg-4 o_light_label"/>
                                    <field name="zenlenet_netbox_sync"/>
                                </div>
                                <div class="text-muted mt8"><field name="zenlenet_netbox_last_sync" readonly="1" class="w-auto"/> <field name="zenlenet_netbox_last_stats" readonly="1" class="w-auto ms-2"/></div>
                                <div class="mt8">
                                    <button name="action_netbox_sync" type="object" string="立即同步" icon="fa-refresh" class="btn-link" invisible="not zenlenet_netbox_ready"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
    <record id="action_settings" model="ir.actions.act_window">
        <field name="name">设置</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'zenlenet_ops', 'bin_size': False}</field>
    </record>
    <record id="view_product_list_zenlenet" model="ir.ui.view">
        <field name="name">zenlenet.product.list</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="default_code" string="SKU" required="1"/>
                <field name="name" string="业务"/>
                <field name="list_price" string="单价（月）"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="sale_ok" string="可报价"/>
                <field name="type" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="action_products" model="ir.actions.act_window">
        <field name="name">产品与定价</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_product_list_zenlenet"/>
        <field name="domain">[('sale_ok', '=', True)]</field>
        <field name="context">{'default_type': 'service', 'default_sale_ok': True}</field>
    </record>
</odoo>
