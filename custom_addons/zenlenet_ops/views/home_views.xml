<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_home_form" model="ir.ui.view">
        <field name="name">zenlenet.home.form</field>
        <field name="model">zenlenet.home</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0" duplicate="0" class="o_zl_home">
                <sheet class="o_zl_sheet">
                    <field name="currency_id" invisible="1"/>
                    <field name="name" invisible="1"/>

                    <div class="o_zl_section_title">待办提醒</div>
                    <div class="o_zl_kpis">
                        <button type="object" name="action_open_my_flows" class="o_zl_kpi o_zl_kpi_primary">
                            <span class="o_zl_kpi_value"><field name="flows_mine" readonly="1"/></span>
                            <span class="o_zl_kpi_label">我的在办交付</span>
                            <span class="o_zl_kpi_sub">全部在办 <field name="flows_open" readonly="1"/> · 待分配资源 <field name="allocations_pending" readonly="1"/></span>
                        </button>
                        <button type="object" name="action_open_overdue_tickets" class="o_zl_kpi o_zl_kpi_danger">
                            <span class="o_zl_kpi_value"><field name="tickets_overdue" readonly="1"/></span>
                            <span class="o_zl_kpi_label">超时工单</span>
                            <span class="o_zl_kpi_sub">未关闭 <field name="tickets_open" readonly="1"/> · 待派单 <field name="tickets_new" readonly="1"/></span>
                        </button>
                        <button type="object" name="action_open_unpaid" class="o_zl_kpi o_zl_kpi_warning">
                            <span class="o_zl_kpi_value"><field name="unpaid_amount" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/></span>
                            <span class="o_zl_kpi_label">未收款</span>
                            <span class="o_zl_kpi_sub"><field name="unpaid_count" readonly="1"/> 张已确认账单 · 草稿 <field name="invoices_draft" readonly="1"/></span>
                        </button>
                        <button type="object" name="action_open_expiring" class="o_zl_kpi o_zl_kpi_info">
                            <span class="o_zl_kpi_value"><field name="contracts_expiring" readonly="1"/></span>
                            <span class="o_zl_kpi_label">待续签合同</span>
                            <span class="o_zl_kpi_sub">执行中 <field name="contracts_running" readonly="1"/></span>
                        </button>
                    </div>

                    <div class="o_zl_section_title">运营指标</div>
                    <div class="o_zl_stats">
                        <div class="o_zl_stat"><span class="o_zl_stat_value"><field name="customers_active" readonly="1"/></span><span class="o_zl_stat_label">在网客户 / 共 <field name="customers_total" readonly="1"/></span></div>
                        <div class="o_zl_stat"><span class="o_zl_stat_value"><field name="services_active" readonly="1"/></span><span class="o_zl_stat_label">在网服务 · 测试中 <field name="services_testing" readonly="1"/></span></div>
                        <div class="o_zl_stat"><span class="o_zl_stat_value"><field name="mrr" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/></span><span class="o_zl_stat_label">月费合计（演示价目）</span></div>
                        <div class="o_zl_stat"><span class="o_zl_stat_value"><field name="quotes_open" readonly="1"/></span><span class="o_zl_stat_label">待确认报价</span></div>
                        <div class="o_zl_stat"><span class="o_zl_stat_value"><field name="ip_usage" readonly="1"/>%</span><span class="o_zl_stat_label">IP 使用率 · 未分配 <field name="ip_free" readonly="1"/> / <field name="ip_total" readonly="1"/></span></div>
                        <div class="o_zl_stat"><span class="o_zl_stat_value"><field name="lines_active" readonly="1"/></span><span class="o_zl_stat_label">在用线路 · <field name="datacenters" readonly="1"/> 个数据中心</span></div>
                    </div>

                    <div class="o_zl_section_title">系统</div>
                    <div class="o_zl_apps">
                        <button type="action" name="%(zenlenet_ops.action_customers)d" class="o_zl_app"><i class="fa fa-building-o" title="客户"/><b>客户</b></button>
                        <button type="action" name="%(zenlenet_ops.action_month)d" class="o_zl_app" groups="zenlenet_ops.group_sales,zenlenet_ops.group_finance,zenlenet_ops.group_manager"><i class="fa fa-calendar" title="出账"/><b>出账</b></button>
                        <button type="action" name="%(zenlenet_ops.action_flow)d" class="o_zl_app"><i class="fa fa-random" title="资源工单"/><b>资源工单</b></button>
                        <button type="action" name="%(zenlenet_ops.action_tickets)d" class="o_zl_app"><i class="fa fa-life-ring" title="服务工单"/><b>服务工单</b></button>
                        <button type="action" name="%(zenlenet_ops.action_maintenance)d" class="o_zl_app"><i class="fa fa-wrench" title="维护通告"/><b>维护通告</b></button>
                        <button type="action" name="%(zenlenet_ops.action_datacenter_board)d" class="o_zl_app"><i class="fa fa-building" title="数据中心"/><b>数据中心</b></button>
                        <button type="action" name="%(zenlenet_ops.action_allocation_queue)d" class="o_zl_app" groups="zenlenet_ops.group_delivery,zenlenet_ops.group_allocator,zenlenet_ops.group_manager"><i class="fa fa-magic" title="资源分配"/><b>资源分配</b></button>
                        <button type="action" name="%(zenlenet_ops.action_ipam)d" class="o_zl_app"><i class="fa fa-sitemap" title="地址管理"/><b>地址管理</b></button>
                        <button type="action" name="%(zenlenet_ops.action_assets)d" class="o_zl_app"><i class="fa fa-server" title="采购与设备"/><b>采购与设备</b></button>
                    </div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="home_record" model="zenlenet.home">
        <field name="name">工作台</field>
    </record>
    <record id="action_home_page" model="ir.actions.act_window">
        <field name="name">工作台</field>
        <field name="res_model">zenlenet.home</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_home_form"/>
        <field name="res_id" ref="home_record"/>
        <field name="target">current</field>
    </record>
</odoo>
