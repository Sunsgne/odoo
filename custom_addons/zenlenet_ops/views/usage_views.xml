<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_usage_import_form" model="ir.ui.view">
        <field name="name">zenlenet.usage.import.form</field>
        <field name="model">zenlenet.usage.import</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="period"/>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                    <field name="note" nolabel="1" colspan="2"/>
                </group>
                <footer>
                    <button name="action_import" type="object" string="导入" class="btn-primary"/>
                    <button special="cancel" string="取消"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_usage_import" model="ir.actions.act_window">
        <field name="name">导入 95 值</field>
        <field name="res_model">zenlenet.usage.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <record id="view_usage_list" model="ir.ui.view">
        <field name="name">zenlenet.usage.list</field>
        <field name="model">zenlenet.usage</field>
        <field name="arch" type="xml">
            <list editable="bottom" decoration-warning="overage_mbps > 0">
                <header>
                    <button name="%(zenlenet_ops.action_usage_import)d" type="action" string="导入 CSV" class="btn-primary" display="always"/>
                </header>
                <field name="period"/>
                <field name="partner_id"/>
                <field name="order_id" options="{'no_create': True}" domain="[('zenlenet_bill_mode', '=', 'p95')]" context="{'list_view_ref': 'zenlenet_ops.view_order_list'}"/>
                <field name="commit_mbps"/>
                <field name="p95_mbps"/>
                <field name="max_mbps" optional="show"/>
                <field name="avg_mbps" optional="hide"/>
                <field name="billable_mbps"/>
                <field name="overage_mbps"/>
                <field name="source" optional="show"/>
                <field name="graph_ref" optional="hide"/>
                <field name="imported_at" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_usage_search" model="ir.ui.view">
        <field name="name">zenlenet.usage.search</field>
        <field name="model">zenlenet.usage</field>
        <field name="arch" type="xml">
            <search>
                <field name="period"/>
                <field name="partner_id"/>
                <field name="order_id"/>
                <filter name="overage" string="有超量" domain="[('overage_mbps', '>', 0)]"/>
                <group>
                    <filter name="group_period" string="账期" context="{'group_by': 'period'}"/>
                    <filter name="group_partner" string="客户" context="{'group_by': 'partner_id'}"/>
                </group>
                <searchpanel>
                    <field name="period" string="账期" enable_counters="1" icon="fa-calendar" limit="24"/>
                    <field name="source" string="来源" enable_counters="1" expand="1" icon="fa-download"/>
                </searchpanel>
            </search>
        </field>
    </record>
    <record id="action_usage" model="ir.actions.act_window">
        <field name="name">95 值</field>
        <field name="res_model">zenlenet.usage</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_usage_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">还没有 95 值</p>
            <p>Cacti 每月初把 95 值推到 /zenlenet/usage，或在这里导入 CSV。出账时保底之上按超量单价计。</p>
        </field>
    </record>
</odoo>
