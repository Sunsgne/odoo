<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_line_list" model="ir.ui.view">
        <field name="name">zenlenet.line.list</field>
        <field name="model">zenlenet.line</field>
        <field name="arch" type="xml">
            <list decoration-muted="stopped">
                <field name="name"/>
                <field name="kind"/>
                <field name="datacenter_id"/>
                <field name="a_end"/>
                <field name="z_end"/>
                <field name="bandwidth"/>
                <field name="partner_id"/>
                <field name="partner_name" optional="hide"/>
                <field name="supplier" optional="hide"/>
                <field name="monthly_cost" optional="hide" sum="合计"/>
                <field name="end_date" optional="show"/>
                <field name="purpose" optional="hide"/>
                <field name="stopped"/>
            </list>
        </field>
    </record>
    <record id="view_line_form" model="ir.ui.view">
        <field name="name">zenlenet.line.form</field>
        <field name="model">zenlenet.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="线路">
                            <field name="name"/>
                            <field name="kind"/>
                            <field name="datacenter_id"/>
                            <field name="a_end"/>
                            <field name="z_end"/>
                            <field name="bandwidth"/>
                            <field name="stopped"/>
                        </group>
                        <group string="商务">
                            <field name="partner_id"/>
                            <field name="partner_name"/>
                            <field name="supplier"/>
                            <field name="monthly_cost"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="purpose"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_line_search" model="ir.ui.view">
        <field name="name">zenlenet.line.search</field>
        <field name="model">zenlenet.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="a_end"/>
                <field name="z_end"/>
                <field name="partner_name"/>
                <field name="partner_id"/>
                <field name="datacenter_id"/>
                <filter name="private" string="供应商专线" domain="[('kind','=','private')]"/>
                <filter name="vxlan" string="VXLAN" domain="[('kind','=','vxlan')]"/>
                <filter name="running" string="在用" domain="[('stopped','=',False)]"/>
                <filter name="stopped_lines" string="已终止" domain="[('stopped','=',True)]"/>
                <group>
                    <filter name="group_dc" string="数据中心" context="{'group_by': 'datacenter_id'}"/>
                    <filter name="group_partner" string="客户" context="{'group_by': 'partner_id'}"/>
                </group>
                <searchpanel>
                    <field name="datacenter_id" string="数据中心" enable_counters="1" icon="fa-building"/>
                    <field name="kind" string="类型" enable_counters="1" expand="1" icon="fa-exchange"/>
                </searchpanel>
            </search>
        </field>
    </record>
    <record id="action_lines" model="ir.actions.act_window">
        <field name="name">线路</field>
        <field name="res_model">zenlenet.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_line_search"/>
    </record>
</odoo>
