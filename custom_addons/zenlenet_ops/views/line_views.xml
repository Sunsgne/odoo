<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_line_list" model="ir.ui.view">
        <field name="name">zenlenet.line.list</field>
        <field name="model">zenlenet.line</field>
        <field name="arch" type="xml">
            <list decoration-muted="stopped">
                <field name="name" class="font-monospace"/>
                <field name="kind"/>
                <field name="status" widget="badge" decoration-success="status == 'active'" decoration-info="status in ('planned', 'provisioning')" decoration-muted="status == 'decommissioned'" decoration-warning="status in ('offline', 'deprovisioning')"/>
                <field name="datacenter_id"/>
                <field name="a_end"/>
                <field name="z_end"/>
                <field name="bandwidth"/>
                <field name="commit_rate" optional="hide"/>
                <field name="partner_id"/>
                <field name="partner_name" optional="hide"/>
                <field name="supplier_id" optional="show"/>
                <field name="monthly_cost" optional="hide" sum="合计"/>
                <field name="end_date" optional="show"/>
                <field name="purpose" optional="hide"/>
                <field name="stopped" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="view_line_form" model="ir.ui.view">
        <field name="name">zenlenet.line.form</field>
        <field name="model">zenlenet.line</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_netbox" type="object" string="在 NetBox 中查看" icon="fa-external-link" invisible="not netbox_id"/>
                    <field name="status" widget="statusbar" options="{'clickable': true}" statusbar_visible="planned,provisioning,active,decommissioned"/>
                </header>
                <sheet>
                    <group>
                        <group string="线路">
                            <field name="name" class="font-monospace"/>
                            <field name="kind"/>
                            <field name="datacenter_id"/>
                            <field name="commit_rate"/>
                            <field name="bandwidth"/>
                            <field name="stopped" invisible="1"/>
                        </group>
                        <group string="商务">
                            <field name="partner_id"/>
                            <field name="partner_name" invisible="1"/>
                            <field name="supplier_id" options="{'no_create': True}"/>
                            <field name="monthly_cost"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="purpose"/>
                        </group>
                    </group>
                    <group string="SD-WAN" invisible="kind != 'sdwan'">
                        <field name="region"/>
                    </group>
                    <group string="两端" invisible="kind == 'sdwan'">
                        <group string="A 端">
                            <field name="a_site_id"/>
                            <field name="a_device_id" domain="[('datacenter_id', '=', a_site_id)]"/>
                            <field name="a_port"/>
                            <field name="a_vlan"/>
                        </group>
                        <group string="Z 端">
                            <field name="z_site_id"/>
                            <field name="z_device_id" domain="[('datacenter_id', '=', z_site_id)]"/>
                            <field name="z_port"/>
                            <field name="z_vlan"/>
                        </group>
                    </group>
                    <group string="导入时的文字" invisible="not a_end and not z_end">
                        <field name="a_end" readonly="1"/>
                        <field name="z_end" readonly="1"/>
                    </group>
                    <separator string="交付记录"/>
                    <field name="allocation_ids" readonly="1" nolabel="1">
                        <list limit="20">
                            <field name="flow_id"/>
                            <field name="order_id"/>
                            <field name="partner_id"/>
                            <field name="spec"/>
                            <field name="flow_state"/>
                        </list>
                    </field>
                    <group string="NetBox" invisible="not netbox_id">
                        <field name="netbox_id"/>
                        <field name="netbox_synced"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_line_search" model="ir.ui.view">
        <field name="name">zenlenet.line.search</field>
        <field name="model">zenlenet.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="a_end"/>
                <field name="z_end"/>
                <field name="partner_name"/>
                <field name="partner_id"/>
                <field name="datacenter_id"/>
                <filter name="pl" string="专线" domain="[('kind','=','pl')]"/>
                <filter name="sdwan" string="SD-WAN" domain="[('kind','=','sdwan')]"/>
                <filter name="private" string="供应商专线" domain="[('kind','=','private')]"/>
                <filter name="vxlan" string="VXLAN" domain="[('kind','=','vxlan')]"/>
                <filter name="running" string="在用" domain="[('status','=','active')]"/>
                <filter name="stopped_lines" string="已终止" domain="[('stopped','=',True)]"/>
                <group>
                    <filter name="group_dc" string="数据中心" context="{'group_by': 'datacenter_id'}"/>
                    <filter name="group_partner" string="客户" context="{'group_by': 'partner_id'}"/>
                </group>
                <searchpanel>
                    <field name="datacenter_id" string="数据中心" enable_counters="1" icon="fa-building" limit="60"/>
                    <field name="kind" string="类型" enable_counters="1" expand="1" icon="fa-exchange"/>
                    <field name="status" string="状态" enable_counters="1" expand="1" icon="fa-flag"/>
                    <field name="supplier_id" string="供应商" enable_counters="1" icon="fa-truck" limit="40"/>
                </searchpanel>
            </search>
        </field>
    </record>
    <record id="action_lines" model="ir.actions.act_window">
        <field name="name">线路</field>
        <field name="res_model">zenlenet.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_line_search"/>
        <field name="context">{'search_default_running': 1}</field>
    </record>
</odoo>
