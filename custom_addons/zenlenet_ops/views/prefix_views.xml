<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_prefix_list" model="ir.ui.view">
        <field name="name">zenlenet.prefix.list</field>
        <field name="model">zenlenet.prefix</field>
        <field name="arch" type="xml">
            <list decoration-muted="status == 'deprecated'" decoration-bf="status == 'container'">
                <header>
                    <button name="%(zenlenet_ops.action_prefix_add)d" type="action" string="录入网段" class="btn-primary" display="always" groups="zenlenet_ops.group_delivery,zenlenet_ops.group_manager"/>
                </header>
                <field name="prefix" class="font-monospace"/>
                <field name="region" optional="show"/>
                <field name="asn_display" string="AS 号" optional="show"/>
                <field name="top_id" string="IP 段" optional="show"/>
                <field name="parent_id" optional="hide"/>
                <field name="status" widget="badge" decoration-success="status == 'active'" decoration-info="status == 'container'" decoration-warning="status == 'reserved'"/>
                <field name="datacenter_id"/>
                <field name="partner_id" string="分配给"/>
                <field name="role" optional="show"/>
                <field name="vlan" optional="hide"/>
                <field name="size_display" string="容量"/>
                <field name="child_count" string="下级网段" optional="show"/>
                <field name="allocated_count"/>
                <field name="free_count"/>
                <field name="utilization" widget="progressbar"/>
                <field name="description" optional="show"/>
                <field name="netbox_synced" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_prefix_form" model="ir.ui.view">
        <field name="name">zenlenet.prefix.form</field>
        <field name="model">zenlenet.prefix</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_allocate" type="object" string="开开通工单" class="btn-primary" groups="zenlenet_ops.group_delivery,zenlenet_ops.group_sales,zenlenet_ops.group_manager"/>
                    <button name="action_release" type="object" string="开退回工单" groups="zenlenet_ops.group_delivery,zenlenet_ops.group_sales,zenlenet_ops.group_manager"/>
                    <button name="action_add_child" type="object" string="新增下级网段" invisible="status == 'deprecated'" groups="zenlenet_ops.group_delivery,zenlenet_ops.group_manager"/>
                    <button name="action_open_netbox" type="object" string="在 NetBox 中查看" icon="fa-external-link" invisible="not netbox_id"/>
                    <field name="status" widget="statusbar" options="{'clickable': true}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <div class="text-muted small" invisible="not parent_id">上级 <field name="parent_id" readonly="1" class="d-inline w-auto"/></div>
                        <h1><field name="prefix" class="font-monospace"/></h1>
                        <div class="d-flex gap-2 align-items-center">
                            <field name="utilization" widget="progressbar" class="flex-grow-1" style="max-width: 320px;"/>
                            <span class="text-muted small">已分配 <field name="allocated_count" readonly="1" class="d-inline w-auto"/> · 未分配 <field name="free_count" readonly="1" class="d-inline w-auto"/> · 容量 <field name="size_display" readonly="1" class="d-inline w-auto"/></span>
                        </div>
                    </div>
                    <group>
                        <group string="分配">
                            <field name="domain_id"/>
                            <field name="region"/>
                            <field name="asn"/>
                            <field name="top_id" string="IP 段"/>
                            <field name="partner_id" string="分配给客户" options="{'no_create': True}" domain="[('is_company', '=', True), ('customer_rank', '>', 0)]"/>
                            <field name="datacenter_id"/>
                            <field name="role"/>
                            <field name="vlan"/>
                            <field name="description"/>
                        </group>
                        <group string="网络">
                            <field name="family"/>
                            <field name="netmask"/>
                            <field name="first_ip" class="font-monospace"/>
                            <field name="last_ip" class="font-monospace"/>
                            <field name="is_pool"/>
                            <field name="netbox_id" invisible="not netbox_id"/>
                            <field name="netbox_synced" invisible="not netbox_id"/>
                        </group>
                    </group>
                    <separator string="下级网段"/>
                    <field name="child_ids" readonly="1" nolabel="1">
                        <list decoration-muted="status == 'deprecated'" limit="40">
                            <field name="prefix" class="font-monospace"/>
                            <field name="status" widget="badge" decoration-success="status == 'active'" decoration-info="status == 'container'" decoration-warning="status == 'reserved'"/>
                            <field name="partner_id" string="分配给"/>
                            <field name="size_display" string="容量"/>
                            <field name="allocated_count"/>
                            <field name="free_count"/>
                            <field name="utilization" widget="progressbar"/>
                            <field name="description"/>
                        </list>
                    </field>
                    <separator string="IP 地址"/>
                    <field name="address_ids" nolabel="1" context="{'default_block': prefix, 'default_datacenter_id': datacenter_id}">
                        <list editable="bottom" limit="80" decoration-success="status == 'allocated'" decoration-muted="status == 'free'" decoration-warning="status in ('reserved', 'transferring', 'returning')">
                            <field name="address" class="font-monospace"/>
                            <field name="status" widget="badge" decoration-success="status == 'allocated'" decoration-info="status == 'free'" decoration-warning="status in ('reserved', 'transferring', 'returning')"/>
                            <field name="partner_id" string="分配给"/>
                            <field name="net_attr"/>
                            <field name="usage"/>
                            <field name="expires_on" optional="hide"/>
                            <field name="netbox_id" column_invisible="1"/>
                        </list>
                    </field>
                    <separator string="交付记录"/>
                    <field name="allocation_ids" readonly="1" nolabel="1">
                        <list limit="40">
                            <field name="flow_id"/>
                            <field name="order_id"/>
                            <field name="partner_id"/>
                            <field name="service_type"/>
                            <field name="spec"/>
                            <field name="flow_state"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_prefix_search" model="ir.ui.view">
        <field name="name">zenlenet.prefix.search</field>
        <field name="model">zenlenet.prefix</field>
        <field name="arch" type="xml">
            <search>
                <field name="prefix" filter_domain="['|', '|', ('prefix', 'ilike', self), ('description', 'ilike', self), ('address_ids.address', 'ilike', self)]" string="网段 / IP / 说明"/>
                <field name="partner_id"/>
                <filter name="top" string="顶级网段" domain="[('parent_id', '=', False)]"/>
                <filter name="active" string="在用" domain="[('status', '=', 'active')]"/>
                <filter name="unassigned" string="未分配给客户" domain="[('partner_id', '=', False), ('status', 'in', ('active', 'reserved'))]"/>
                <filter name="v4" string="IPv4" domain="[('family', '=', '4')]"/>
                <filter name="v6" string="IPv6" domain="[('family', '=', '6')]"/>
                <group>
                    <filter name="group_region" string="地区" context="{'group_by': 'region'}"/>
                    <filter name="group_asn" string="AS 号" context="{'group_by': 'asn'}"/>
                    <filter name="group_parent" string="上级网段" context="{'group_by': 'parent_id'}"/>
                    <filter name="group_dc" string="数据中心" context="{'group_by': 'datacenter_id'}"/>
                    <filter name="group_partner" string="分配给" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_status" string="状态" context="{'group_by': 'status'}"/>
                </group>
                <searchpanel>
                    <field name="datacenter_id" string="数据中心" enable_counters="1" icon="fa-building" limit="60"/>
                    <field name="status" string="状态" enable_counters="1" expand="1" icon="fa-flag"/>
                    <field name="family" string="协议" enable_counters="1" expand="1" icon="fa-code-fork"/>
                </searchpanel>
            </search>
        </field>
    </record>
    <record id="action_prefixes" model="ir.actions.act_window">
        <field name="name">网段列表</field>
        <field name="res_model">zenlenet.prefix</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_prefix_search"/>
        <field name="context">{'search_default_group_parent': 1}</field>
    </record>
    <record id="action_ipam" model="ir.actions.client">
        <field name="name">地址管理</field>
        <field name="tag">zenlenet_ipam</field>
    </record>
    <record id="view_ipam_domain_list" model="ir.ui.view">
        <field name="name">zenlenet.ipam.domain.list</field>
        <field name="model">zenlenet.ipam.domain</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="prefix_count"/>
            </list>
        </field>
    </record>
    <record id="action_ipam_domains" model="ir.actions.act_window">
        <field name="name">管理域</field>
        <field name="res_model">zenlenet.ipam.domain</field>
        <field name="view_mode">list,form</field>
    </record>
    <delete model="ir.ui.view" id="view_prefix_split_form"/>
    <record id="view_price_item_list" model="ir.ui.view">
        <field name="name">zenlenet.price.item.list</field>
        <field name="model">product.pricelist.item</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="product_tmpl_id" string="业务" options="{'no_create': True}" domain="[('sale_ok', '=', True)]" required="1"/>
                <field name="min_quantity" string="起订量"/>
                <field name="fixed_price" string="客户单价 / 月"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="date_start" string="生效" optional="hide"/>
                <field name="date_end" string="失效" optional="hide"/>
                <field name="pricelist_id" column_invisible="1"/>
                <field name="applied_on" column_invisible="1"/>
                <field name="compute_price" column_invisible="1"/>
            </list>
        </field>
    </record>
</odoo>
