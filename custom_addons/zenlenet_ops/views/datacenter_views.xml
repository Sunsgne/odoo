<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_datacenter_kanban" model="ir.ui.view">
        <field name="name">zenlenet.datacenter.kanban</field>
        <field name="model">zenlenet.datacenter</field>
        <field name="arch" type="xml">
            <kanban records_draggable="0" quick_create="false" class="o_kanban_small_column">
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="fw-bold fs-5"><field name="name"/></div>
                                <div class="text-muted small">
                                    <field name="kind"/>
                                    <t t-if="record.city.raw_value"> · <field name="city"/></t>
                                    <t t-if="record.supplier.raw_value"> · <field name="supplier"/></t>
                                </div>
                            </div>
                            <field name="state" widget="badge" decoration-success="state == 'active'" decoration-muted="state == 'closed'" decoration-info="state == 'planning'"/>
                        </div>
                        <div class="row mt-2 text-center">
                            <div class="col"><div class="fw-bold"><field name="address_count"/></div><div class="text-muted small">地址</div></div>
                            <div class="col"><div class="fw-bold text-success"><field name="free_count"/></div><div class="text-muted small">未分配</div></div>
                            <div class="col"><div class="fw-bold"><field name="line_count"/></div><div class="text-muted small">线路</div></div>
                            <div class="col"><div class="fw-bold"><field name="asset_count"/></div><div class="text-muted small">设备</div></div>
                        </div>
                        <div class="mt-2">
                            <field name="usage_percent" widget="progressbar" options="{'editable': false}"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="view_datacenter_list" model="ir.ui.view">
        <field name="name">zenlenet.datacenter.list</field>
        <field name="model">zenlenet.datacenter</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="kind"/>
                <field name="city"/>
                <field name="supplier"/>
                <field name="address_count"/>
                <field name="free_count"/>
                <field name="line_count"/>
                <field name="asset_count"/>
                <field name="usage_percent" widget="progressbar"/>
                <field name="state" widget="badge" decoration-success="state == 'active'" decoration-muted="state == 'closed'"/>
            </list>
        </field>
    </record>
    <record id="view_datacenter_form" model="ir.ui.view">
        <field name="name">zenlenet.datacenter.form</field>
        <field name="model">zenlenet.datacenter</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_netbox" type="object" string="在 NetBox 中查看" icon="fa-external-link" invisible="not netbox_id"/>
                    <field name="state" widget="statusbar" options="{'clickable': true}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_prefixes" type="object" class="oe_stat_button" icon="fa-th-large">
                            <field name="prefix_count" widget="statinfo" string="地址段"/>
                        </button>
                        <button name="action_open_addresses" type="object" class="oe_stat_button" icon="fa-sitemap">
                            <field name="address_count" widget="statinfo" string="IP 地址"/>
                        </button>
                        <button name="action_open_lines" type="object" class="oe_stat_button" icon="fa-exchange">
                            <field name="line_count" widget="statinfo" string="线路"/>
                        </button>
                        <button name="action_open_assets" type="object" class="oe_stat_button" icon="fa-server">
                            <field name="asset_count" widget="statinfo" string="设备"/>
                        </button>
                        <button name="action_open_maintenance" type="object" class="oe_stat_button" icon="fa-wrench">
                            <div class="o_stat_info"><span class="o_stat_text">割接维护</span></div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="数据中心名称"/></h1>
                    </div>
                    <group>
                        <group string="基本">
                            <field name="code"/>
                            <field name="facility"/>
                            <field name="kind"/>
                            <field name="supplier"/>
                            <field name="usage_percent" widget="progressbar"/>
                        </group>
                        <group string="地点与联系">
                            <field name="city"/>
                            <field name="country_id"/>
                            <field name="address"/>
                            <field name="contact"/>
                            <field name="phone"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="IP 地址">
                            <field name="address_ids" readonly="1">
                                <list>
                                    <field name="address"/>
                                    <field name="block"/>
                                    <field name="partner_id"/>
                                    <field name="status"/>
                                    <field name="net_attr"/>
                                </list>
                            </field>
                        </page>
                        <page string="线路">
                            <field name="line_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="kind"/>
                                    <field name="a_end"/>
                                    <field name="z_end"/>
                                    <field name="bandwidth"/>
                                    <field name="partner_id"/>
                                    <field name="stopped"/>
                                </list>
                            </field>
                        </page>
                        <page string="备注">
                            <field name="note" placeholder="出入机房流程、电力、机柜编号等"/>
                            <group string="NetBox" invisible="not netbox_id">
                                <field name="netbox_id"/>
                                <field name="netbox_synced"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_datacenter_search" model="ir.ui.view">
        <field name="name">zenlenet.datacenter.search</field>
        <field name="model">zenlenet.datacenter</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="city"/>
                <field name="supplier"/>
                <filter name="active" string="在用" domain="[('state', '=', 'active')]"/>
                <filter name="closed" string="已退租" domain="[('state', '=', 'closed')]"/>
                <group>
                    <filter name="group_kind" string="类型" context="{'group_by': 'kind'}"/>
                    <filter name="group_state" string="状态" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_datacenters" model="ir.actions.act_window">
        <field name="name">数据中心</field>
        <field name="res_model">zenlenet.datacenter</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_datacenter_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">还没有数据中心</p>
            <p>新建一个机房或 POP 点，IP、线路和设备就能挂到它下面。</p>
        </field>
    </record>
</odoo>
