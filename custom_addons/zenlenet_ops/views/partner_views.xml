<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_list" model="ir.ui.view">
        <field name="name">zenlenet.partner.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" string="客户"/>
                <field name="zenlenet_status" widget="badge" decoration-success="zenlenet_status == 'active'" decoration-info="zenlenet_status == 'testing'" decoration-muted="zenlenet_status == 'churned'"/>
                <field name="zenlenet_manager_id" widget="many2one_avatar_user" optional="show"/>
                <field name="country_id" string="国家" optional="show"/>
                <field name="phone" string="电话" optional="hide"/>
                <field name="email" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_partner_form_simple" model="ir.ui.view">
        <field name="name">zenlenet.partner.form</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_quote" type="object" string="新报价" class="btn-primary"/>
                    <field name="zenlenet_status" widget="statusbar" options="{'clickable': true}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_orders" type="object" class="oe_stat_button" icon="fa-plug">
                            <field name="zenlenet_order_count" widget="statinfo" string="服务订单"/>
                        </button>
                        <button name="action_open_contracts" type="object" class="oe_stat_button" icon="fa-handshake-o">
                            <field name="zenlenet_contract_count" widget="statinfo" string="合同"/>
                        </button>
                        <button name="action_open_invoices" type="object" class="oe_stat_button" icon="fa-money">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="zenlenet_unpaid_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/></span>
                                <span class="o_stat_text">未收款 · <field name="zenlenet_invoice_count"/> 张账单</span>
                            </div>
                        </button>
                        <button name="action_open_flows" type="object" class="oe_stat_button" icon="fa-random">
                            <field name="zenlenet_flow_count" widget="statinfo" string="在办交付"/>
                        </button>
                        <button name="action_open_tickets" type="object" class="oe_stat_button" icon="fa-life-ring">
                            <field name="zenlenet_ticket_count" widget="statinfo" string="未关闭工单"/>
                        </button>
                        <button name="action_open_resources" type="object" class="oe_stat_button" icon="fa-sitemap">
                            <field name="zenlenet_address_count" widget="statinfo" string="IP资源"/>
                        </button>
                        <button name="action_open_lines" type="object" class="oe_stat_button" icon="fa-exchange">
                            <field name="zenlenet_line_count" widget="statinfo" string="线路"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="客户名称"/></h1>
                    </div>
                    <group>
                        <group string="商务">
                            <field name="zenlenet_manager_id" widget="many2one_avatar_user"/>
                            <field name="zenlenet_mrr"/>
                            <field name="zenlenet_since"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="联系">
                            <field name="phone" widget="phone"/>
                            <field name="email" widget="email"/>
                            <field name="website" widget="url"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="地址与备注">
                            <group>
                                <group>
                                    <field name="street" string="地址"/>
                                    <field name="city" string="城市"/>
                                    <field name="country_id" string="国家"/>
                                </group>
                                <group>
                                    <field name="vat" string="税号 / 注册号"/>
                                    <field name="lang" string="语言"/>
                                </group>
                            </group>
                            <field name="comment" placeholder="对接人、付款习惯、特殊约定"/>
                        </page>
                        <page string="联系人">
                            <field name="child_ids" context="{'default_parent_id': id, 'default_is_company': False, 'default_type': 'contact'}">
                                <list editable="bottom">
                                    <field name="name" string="姓名"/>
                                    <field name="function" string="职务"/>
                                    <field name="phone" string="电话" widget="phone"/>
                                    <field name="email" widget="email"/>
                                    <field name="type" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <field name="is_company" invisible="1"/>
                    <field name="company_type" invisible="1"/>
                    <field name="customer_rank" invisible="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_partner_search_zenlenet" model="ir.ui.view">
        <field name="name">zenlenet.partner.search</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="zenlenet_manager_id"/>
                <filter name="active_customers" string="在网" domain="[('zenlenet_status','=','active')]"/>
                <filter name="testing_customers" string="测试" domain="[('zenlenet_status','=','testing')]"/>
                <filter name="churned_customers" string="已退租" domain="[('zenlenet_status','=','churned')]"/>
                <group>
                    <filter name="group_status" string="业务状态" context="{'group_by': 'zenlenet_status'}"/>
                    <filter name="group_manager" string="客户经理" context="{'group_by': 'zenlenet_manager_id'}"/>
                    <filter name="group_country" string="国家" context="{'group_by': 'country_id'}"/>
                </group>
                <searchpanel>
                    <field name="zenlenet_status" string="业务状态" enable_counters="1" expand="1" icon="fa-tag"/>
                    <field name="country_id" string="国家" enable_counters="1" icon="fa-globe" limit="40"/>
                </searchpanel>
            </search>
        </field>
    </record>
    <record id="hide_partner_sales_button" model="ir.ui.view">
        <field name="name">zenlenet.partner.hide.sales</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="sale.res_partner_view_buttons"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='sale.act_res_partner_2_sale_order']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
    <record id="action_customers" model="ir.actions.act_window">
        <field name="name">客户管理</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_company', '=', True), ('customer_rank', '&gt;', 0)]</field>
        <field name="context">{'default_is_company': True, 'default_company_type': 'company', 'default_customer_rank': 1}</field>
        <field name="search_view_id" ref="view_partner_search_zenlenet"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_partner_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_partner_form_simple')})]"/>
    </record>
</odoo>
