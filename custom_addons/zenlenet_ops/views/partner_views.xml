<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_list" model="ir.ui.view">
        <field name="name">zenlenet.partner.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list decoration-muted="zenlenet_status == 'churned'">
                <field name="zenlenet_code" string="编号" class="font-monospace"/>
                <field name="name" string="客户"/>
                <field name="zenlenet_status" widget="badge" decoration-success="zenlenet_status == 'active'" decoration-info="zenlenet_status == 'testing'" decoration-warning="zenlenet_status == 'lead'" decoration-muted="zenlenet_status == 'churned'"/>
                <field name="zenlenet_level" optional="show"/>
                <field name="zenlenet_manager_id" widget="many2one_avatar_user"/>
                <field name="zenlenet_currency_id" string="币种"/>
                <field name="zenlenet_mrr" optional="show"/>
                <field name="zenlenet_order_count" string="服务" optional="show"/>
                <field name="zenlenet_unpaid_amount" string="未收款" optional="show"/>
                <field name="country_id" string="国家" optional="hide"/>
                <field name="zenlenet_industry" optional="hide"/>
                <field name="zenlenet_source" optional="hide"/>
                <field name="create_uid" string="登记人" widget="many2one_avatar_user" optional="show"/>
                <field name="create_date" string="登记时间" optional="show"/>
                <field name="phone" string="电话" optional="hide"/>
                <field name="email" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_partner_form_simple" model="ir.ui.view">
        <field name="name">zenlenet.partner.form</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_quote" type="object" string="新报价" class="btn-primary"/>
                    <button name="action_open_prices" type="object" string="专属价格"/>
                    <field name="zenlenet_status" widget="statusbar" options="{'clickable': true}"/>
                </header>
                <sheet>
                    <div class="o_zl_chain">
                        <div class="o_zl_chain_step"><b><field name="zenlenet_order_count"/></b><span>服务订单</span></div>
                        <div class="o_zl_chain_step"><b><field name="zenlenet_contract_count"/></b><span>合同</span></div>
                        <div class="o_zl_chain_step"><b><field name="zenlenet_unpaid_amount" widget="monetary" options="{'currency_field': 'zenlenet_currency_id'}"/></b><span>未收款 · <field name="zenlenet_invoice_count"/> 张</span></div>
                        <div class="o_zl_chain_step"><b><field name="zenlenet_flow_count"/></b><span>交付工单</span></div>
                        <div class="o_zl_chain_step"><b><field name="zenlenet_ticket_count"/></b><span>服务工单</span></div>
                        <div class="o_zl_chain_step"><b><field name="zenlenet_address_count"/></b><span>IP</span></div>
                        <div class="o_zl_chain_step"><b><field name="zenlenet_line_count"/></b><span>线路</span></div>
                    </div>
                    <div class="text-muted small mb-2">明细都在下面。点一行在当前页打开，不用另开菜单。</div>
                    <div class="oe_title">
                        <div class="text-muted font-monospace"><field name="zenlenet_code" readonly="1"/></div>
                        <h1><field name="name" placeholder="客户名称"/></h1>
                    </div>
                    <group>
                        <group string="归属">
                            <field name="zenlenet_manager_id" widget="many2one_avatar_user"/>
                            <field name="zenlenet_level"/>
                            <field name="zenlenet_source"/>
                            <field name="zenlenet_industry"/>
                            <field name="create_uid" string="登记人" readonly="1" widget="many2one_avatar_user"/>
                            <field name="create_date" string="登记时间" readonly="1"/>
                        </group>
                        <group string="结算">
                            <field name="zenlenet_currency_id" options="{'no_create': True}"/>
                            <field name="zenlenet_payment_days"/>
                            <field name="zenlenet_mrr"/>
                            <field name="zenlenet_since"/>
                            <field name="vat" string="税号 / 注册号"/>
                            <field name="property_product_pricelist" invisible="1"/>
                        </group>
                        <group string="商务联系">
                            <field name="zenlenet_commercial_contact"/>
                            <field name="phone" widget="phone"/>
                            <field name="email" widget="email"/>
                            <field name="website" widget="url"/>
                        </group>
                        <group string="技术联系（NOC）">
                            <field name="zenlenet_noc_email" widget="email"/>
                            <field name="zenlenet_noc_phone" widget="phone"/>
                            <field name="street" string="地址"/>
                            <field name="city" string="城市"/>
                            <field name="country_id" string="国家"/>
                        </group>
                    </group>
                    <group string="联系人">
                        <field name="child_ids" nolabel="1" colspan="2" context="{'default_parent_id': id, 'default_is_company': False, 'default_type': 'contact'}">
                            <list editable="bottom">
                                <field name="name" string="姓名"/>
                                <field name="function" string="职务"/>
                                <field name="phone" string="电话" widget="phone"/>
                                <field name="email" widget="email"/>
                                <field name="type" column_invisible="1"/>
                            </list>
                        </field>
                    </group>
                    <field name="comment" placeholder="对接情况、付款习惯、特殊约定"/>
                    <notebook>
                        <page string="服务订单">
                            <field name="sale_order_ids" readonly="1" context="{'list_view_ref': 'zenlenet_ops.view_order_list'}">
                                <list limit="20" default_order="date_order desc">
                                    <field name="name" string="单号"/>
                                    <field name="origin" string="业务"/>
                                    <field name="amount_untaxed" string="月费"/>
                                    <field name="currency_id" string="币种"/>
                                    <field name="zenlenet_contract_id" string="合同"/>
                                    <field name="zenlenet_contract_state" string="合同状态" widget="badge"/>
                                    <field name="zenlenet_flow_count" string="交付"/>
                                    <field name="zenlenet_stage" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="合同">
                            <field name="zenlenet_contract_ids" readonly="1">
                                <list limit="20">
                                    <field name="name"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="billing_cycle"/>
                                    <field name="monthly_amount"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="账单">
                            <field name="zenlenet_invoice_ids" readonly="1">
                                <list limit="20" default_order="invoice_date desc">
                                    <field name="name" string="账单"/>
                                    <field name="ref" string="账期"/>
                                    <field name="invoice_date" string="日期"/>
                                    <field name="amount_total" string="金额"/>
                                    <field name="amount_residual" string="未收"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="payment_state" string="收款" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="服务工单">
                            <field name="zenlenet_ticket_ids" readonly="1">
                                <list limit="20">
                                    <field name="name"/>
                                    <field name="priority" widget="priority"/>
                                    <field name="subject"/>
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="due_at"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="交付工单">
                            <field name="zenlenet_flow_ids" readonly="1">
                                <list limit="20">
                                    <field name="name"/>
                                    <field name="order_id"/>
                                    <field name="state"/>
                                    <field name="datacenter_id"/>
                                    <field name="pending_count" string="待分配"/>
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                </list>
                            </field>
                        </page>
                        <page string="IP 地址段">
                            <field name="zenlenet_prefix_ids" readonly="1">
                                <list limit="20">
                                    <field name="prefix" class="font-monospace"/>
                                    <field name="datacenter_id"/>
                                    <field name="size_display"/>
                                    <field name="allocated_count"/>
                                    <field name="utilization" widget="progressbar"/>
                                    <field name="status" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="IP 地址">
                            <field name="zenlenet_address_ids" readonly="1">
                                <list limit="40">
                                    <field name="address" class="font-monospace"/>
                                    <field name="status" widget="badge"/>
                                    <field name="usage"/>
                                    <field name="datacenter_id"/>
                                    <field name="prefix_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="线路">
                            <field name="zenlenet_line_ids" readonly="1">
                                <list limit="20">
                                    <field name="name"/>
                                    <field name="kind"/>
                                    <field name="status"/>
                                    <field name="datacenter_id"/>
                                    <field name="bandwidth"/>
                                    <field name="supplier_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <field name="is_company" invisible="1"/>
                    <field name="company_type" invisible="1"/>
                    <field name="customer_rank" invisible="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_partner_search_zenlenet" model="ir.ui.view">
        <field name="name">zenlenet.partner.search</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', '|', ('name', 'ilike', self), ('zenlenet_code', 'ilike', self), ('email', 'ilike', self)]" string="客户 / 编号 / 邮箱"/>
                <field name="zenlenet_manager_id"/>
                <filter name="mine" string="我的客户" domain="[('zenlenet_manager_id', '=', uid)]"/>
                <filter name="active_customers" string="在网" domain="[('zenlenet_status','=','active')]"/>
                <filter name="testing_customers" string="测试" domain="[('zenlenet_status','=','testing')]"/>
                <filter name="leads" string="潜在" domain="[('zenlenet_status','=','lead')]"/>
                <filter name="churned_customers" string="已退租" domain="[('zenlenet_status','=','churned')]"/>
                <filter name="no_manager" string="没有客户经理" domain="[('zenlenet_manager_id', '=', False)]"/>
                <group>
                    <filter name="group_status" string="业务状态" context="{'group_by': 'zenlenet_status'}"/>
                    <filter name="group_manager" string="客户经理" context="{'group_by': 'zenlenet_manager_id'}"/>
                    <filter name="group_level" string="等级" context="{'group_by': 'zenlenet_level'}"/>
                    <filter name="group_country" string="国家" context="{'group_by': 'country_id'}"/>
                </group>
                <searchpanel>
                    <field name="zenlenet_status" string="业务状态" enable_counters="1" expand="1" icon="fa-tag"/>
                    <field name="zenlenet_manager_id" string="客户经理" enable_counters="1" icon="fa-user" limit="30"/>
                    <field name="zenlenet_level" string="等级" enable_counters="1" expand="1" icon="fa-star"/>
                </searchpanel>
            </search>
        </field>
    </record>
    <record id="hide_partner_sales_button" model="ir.ui.view">
        <field name="name">zenlenet.partner.hide.sales</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="sale.res_partner_view_buttons"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='sale.act_res_partner_2_sale_order']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
    <record id="action_customers" model="ir.actions.act_window">
        <field name="name">客户</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_company', '=', True), ('customer_rank', '&gt;', 0)]</field>
        <field name="context">{'default_is_company': True, 'default_company_type': 'company', 'default_customer_rank': 1, 'search_default_active_customers': 1}</field>
        <field name="search_view_id" ref="view_partner_search_zenlenet"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_partner_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_partner_form_simple')})]"/>
    </record>
</odoo>
