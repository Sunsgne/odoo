<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_notice_list" model="ir.ui.view">
        <field name="name">zenlenet.notice.template.list</field>
        <field name="model">zenlenet.notice.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="kind"/>
                <field name="scene"/>
            </list>
        </field>
    </record>
    <record id="view_notice_form" model="ir.ui.view">
        <field name="name">zenlenet.notice.template.form</field>
        <field name="model">zenlenet.notice.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="kind"/>
                        <field name="scene"/>
                        <field name="subject"/>
                    </group>
                    <field name="body"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_templates" model="ir.actions.act_window">
        <field name="name">通告模板</field>
        <field name="res_model">zenlenet.notice.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
