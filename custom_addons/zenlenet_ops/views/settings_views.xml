<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ops_user_list" model="ir.ui.view">
        <field name="name">zenlenet.user.list</field>
        <field name="model">res.users</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list create="0">
                <header>
                    <button name="action_zenlenet_add_user" type="object" string="添加账号" class="btn-primary" display="always"/>
                </header>
                <field name="name"/>
                <field name="login"/>
                <field name="zenlenet_role_names" string="岗位"/>
                <field name="email"/>
            </list>
        </field>
    </record>
    <record id="view_ops_user_form" model="ir.ui.view">
        <field name="name">zenlenet.user.form</field>
        <field name="model">res.users</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="login"/>
                        <field name="email"/>
                        <field name="zenlenet_role_ids" widget="many2many_checkboxes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_user_add_form" model="ir.ui.view">
        <field name="name">zenlenet.user.add.form</field>
        <field name="model">zenlenet.user.add</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name"/>
                    <field name="login"/>
                    <field name="role_ids" widget="many2many_checkboxes"/>
                    <field name="password" password="True"/>
                </group>
                <footer>
                    <button name="action_create" type="object" string="创建" class="btn-primary"/>
                    <button special="cancel" string="取消"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_users" model="ir.actions.act_window">
        <field name="name">用户与角色</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('share', '=', False)]</field>
    </record>
    <record id="action_users_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_ops_user_list"/>
        <field name="act_window_id" ref="action_users"/>
    </record>
    <record id="action_users_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_ops_user_form"/>
        <field name="act_window_id" ref="action_users"/>
    </record>
</odoo>
