<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_asset_list" model="ir.ui.view">
        <field name="name">zenlenet.asset.list</field>
        <field name="model">zenlenet.asset</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="model" optional="show"/>
                <field name="partner_id"/>
                <field name="datacenter_id"/>
                <field name="pop" optional="hide"/>
                <field name="serial"/>
                <field name="purchased_on" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'in_use'" decoration-warning="state == 'idle'" decoration-danger="state == 'scrap'"/>
            </list>
        </field>
    </record>
    <record id="view_asset_form" model="ir.ui.view">
        <field name="name">zenlenet.asset.form</field>
        <field name="model">zenlenet.asset</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="model"/>
                            <field name="serial"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="partner_id"/>
                            <field name="datacenter_id"/>
                            <field name="pop"/>
                            <field name="purchased_on"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_assets" model="ir.actions.act_window">
        <field name="name">设备资产</field>
        <field name="res_model">zenlenet.asset</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
