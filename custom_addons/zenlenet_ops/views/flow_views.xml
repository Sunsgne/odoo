<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_flow_kanban" model="ir.ui.view">
        <field name="name">zenlenet.flow.kanban</field>
        <field name="model">zenlenet.flow</field>
        <field name="arch" type="xml">
            <kanban default_group_by="team" records_draggable="0" group_create="false" group_delete="false" quick_create="false" class="o_kanban_small_column">
                <field name="team"/>
                <field name="state"/>
                <field name="kind"/>
                <field name="task_progress"/>
                <field name="risk"/>
                <field name="planned_date"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <span class="fw-bold"><field name="name"/></span>
                            <field name="move" widget="badge"/>
                            <field name="kind" widget="badge" decoration-info="kind == 'test'" decoration-success="kind == 'business'" invisible="move != 'out'"/>
                        </div>
                        <div class="text-truncate"><field name="partner_id"/></div>
                        <div class="text-muted small d-flex justify-content-between">
                            <field name="state"/>
                            <span><field name="risk" widget="badge" decoration-warning="risk == 'at_risk'" decoration-danger="risk == 'blocked'" invisible="risk == 'normal'"/> <field name="planned_date"/></span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-1">
                            <field name="task_progress" widget="progressbar" class="flex-grow-1 me-2"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="view_flow_list" model="ir.ui.view">
        <field name="name">zenlenet.flow.list</field>
        <field name="model">zenlenet.flow</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="move"/>
                <field name="kind" optional="hide"/>
                <field name="team"/>
                <field name="state"/>
                <field name="partner_id"/>
                <field name="order_id"/>
                <field name="pm_user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="planned_date" optional="show"/>
                <field name="task_progress" widget="progressbar" optional="show"/>
                <field name="risk" widget="badge" decoration-success="risk == 'normal'" decoration-warning="risk == 'at_risk'" decoration-danger="risk == 'blocked'"/>
                <field name="next_task_id" optional="show"/>
                <field name="sales_user_id" optional="hide"/>
                <field name="allocator_user_id" optional="hide"/>
                <field name="delivery_user_id" optional="hide"/>
                <field name="service_user_id" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_flow_form" model="ir.ui.view">
        <field name="name">zenlenet.flow.form</field>
        <field name="model">zenlenet.flow</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="can_act" invisible="1"/>
                    <button name="action_prev" type="object" string="退回" invisible="not can_act or state in ('company', 'done', 'cancel')"/>
                    <button name="action_next" type="object" string="推进" class="btn-primary" invisible="not can_act or move != 'out' or state in ('done', 'cancel') or (kind == 'test' and state in ('accept', 'decide'))"/>
                    <button name="action_next" type="object" string="核对资源" class="btn-primary" invisible="not can_act or move != 'in' or state != 'company'"/>
                    <button name="action_next" type="object" string="确认入库" class="btn-primary" invisible="not can_act or move != 'in' or state != 'allocate'"/>
                    <button name="action_next" type="object" string="完成入库" class="btn-primary" invisible="not can_act or move != 'in' or state != 'deliver'"/>
                    <button name="action_next" type="object" string="开始回收" class="btn-primary" invisible="not can_act or move != 'back' or state != 'company'"/>
                    <button name="action_next" type="object" string="确认退回" class="btn-primary" invisible="not can_act or move != 'back' or state != 'reclaim'"/>
                    <button name="action_next" type="object" string="通知客户" class="btn-primary" invisible="not can_act or move != 'cutover' or state != 'company'"/>
                    <button name="action_next" type="object" string="更换资源" class="btn-primary" invisible="not can_act or move != 'cutover' or state != 'deliver'"/>
                    <button name="action_next" type="object" string="业务验证" class="btn-primary" invisible="not can_act or move != 'cutover' or state != 'allocate'"/>
                    <button name="action_next" type="object" string="完成割接" class="btn-primary" invisible="not can_act or move != 'cutover' or state != 'accept'"/>
                    <button name="action_fill_notice" type="object" string="生成割接通知" invisible="move != 'cutover' or state in ('company', 'cancel')"/>
                    <button name="action_reclaim" type="object" string="回收" invisible="not can_act or move != 'out' or kind != 'test' or state not in ('accept', 'decide')"/>
                    <button name="action_to_business" type="object" string="转商务" class="btn-primary" invisible="not can_act or move != 'out' or kind != 'test' or state not in ('accept', 'decide', 'reclaim')"/>
                    <button name="action_print_delivery" type="object" string="打印验收单" invisible="move != 'out' or state in ('company', 'cancel')"/>
                    <button name="action_cancel" type="object" string="取消" invisible="not can_act or state in ('done', 'cancel')"/>
                    <field name="state" widget="statusbar" options="{'clickable': false}" statusbar_visible="company,allocate,deliver,accept,done" invisible="move != 'out' or kind == 'test'"/>
                    <field name="state" widget="statusbar" options="{'clickable': false}" statusbar_visible="company,allocate,deliver,accept,reclaim,done" invisible="move != 'out' or kind != 'test'"/>
                    <field name="state" invisible="1"/>
                </header>
                <sheet>
                    <div class="o_zl_chain">
                        <div class="o_zl_chain_step"><b><field name="partner_id" readonly="1" options="{'no_open': True}"/></b><span>客户</span></div>
                        <div class="o_zl_chain_step"><b><field name="order_id" readonly="1" options="{'no_open': True}"/></b><span>服务订单</span></div>
                        <div class="o_zl_chain_step"><b><field name="contract_id" readonly="1" options="{'no_open': True}"/></b><span>合同 · <field name="contract_state"/> · <field name="contract_monthly" widget="monetary"/></span></div>
                        <div class="o_zl_chain_step"><b><field name="pending_count"/></b><span>待分配</span></div>
                        <div class="o_zl_chain_step"><b><field name="ticket_count"/></b><span>服务工单</span></div>
                    </div>
                    <field name="currency_id" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <field name="contract_id" invisible="1"/>
                    <group>
                        <group>
                            <field name="move" readonly="state != 'company'"/>
                            <field name="kind" readonly="state != 'company'" invisible="move != 'out'"/>
                            <field name="partner_id" invisible="move == 'in'" context="{'default_is_company': True, 'default_company_type': 'company', 'default_customer_rank': 1, 'form_view_ref': 'zenlenet_ops.view_partner_form_simple', 'list_view_ref': 'zenlenet_ops.view_partner_list'}"/>
                            <field name="supplier_id" invisible="move not in ('in', 'back')"/>
                            <field name="return_to" invisible="move != 'back'"/>
                            <field name="place" invisible="move != 'cutover'"/>
                            <field name="window_start" invisible="move != 'cutover'"/>
                            <field name="window_end" invisible="move != 'cutover'"/>
                            <label for="order_id" invisible="move != 'out'"/>
                            <div class="d-flex gap-2 align-items-center" invisible="move != 'out'">
                                <field name="order_id" options="{'no_create': True}" context="{'list_view_ref': 'zenlenet_ops.view_order_list'}" class="flex-grow-1"/>
                                <button name="action_load_order" type="object" string="从订单带入" class="btn btn-secondary btn-sm" invisible="not order_id or state not in ('company', 'allocate')"/>
                            </div>
                            <field name="datacenter_id" options="{'no_create': True}"/>
                            <field name="team" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                        </group>
                        <group string="负责人">
                            <field name="pm_user_id" widget="many2one_avatar_user"/>
                            <field name="sales_user_id" widget="many2one_avatar_user"/>
                            <field name="allocator_user_id" widget="many2one_avatar_user"/>
                            <field name="delivery_user_id" widget="many2one_avatar_user"/>
                            <field name="service_user_id" widget="many2one_avatar_user"/>
                            <field name="procurement_user_id" widget="many2one_avatar_user" invisible="move != 'in'"/>
                        </group>
                        <group string="进度">
                            <field name="planned_date"/>
                            <field name="actual_date" invisible="not actual_date"/>
                            <field name="risk" widget="badge" decoration-success="risk == 'normal'" decoration-warning="risk == 'at_risk'" decoration-danger="risk == 'blocked'"/>
                            <field name="next_task_id" invisible="state in ('done', 'cancel')"/>
                            <field name="overdue_tasks" invisible="not overdue_tasks"/>
                            <field name="note"/>
                        </group>
                    </group>
                    <separator string="这笔订单" invisible="not order_id"/>
                    <field name="order_line_ids" readonly="1" nolabel="1" invisible="not order_id">
                        <list limit="20">
                            <field name="product_id" string="业务"/>
                            <field name="name" string="规格"/>
                            <field name="product_uom_qty" string="数量"/>
                            <field name="price_unit" string="单价 / 月"/>
                            <field name="price_subtotal" string="月费"/>
                            <field name="zenlenet_setup_fee" string="一次性"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                    <separator string="资源"/>
                    <field name="resource_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="service_type" string="业务"/>
                            <field name="flow_move" column_invisible="1"/>
                            <field name="order_line_id" column_invisible="1"/>
                            <field name="order_id" string="订单" optional="hide"/>
                            <field name="spec" string="规格 / 说明"/>
                            <field name="from_prefix_id" string="原网段" options="{'no_create': True}" column_invisible="parent.move != 'cutover'" invisible="service_type not in ('ipt', 'ip')"/>
                            <field name="from_address_id" string="原 IP" options="{'no_create': True}" column_invisible="parent.move != 'cutover'" invisible="service_type != 'ip_single'"/>
                            <field name="from_line_id" string="原线路" options="{'no_create': True}" column_invisible="parent.move != 'cutover'" invisible="service_type not in ('pl', 'sdwan', 'line')"/>
                            <field name="prefix_id" string="网段" options="{'no_create': True}" invisible="service_type not in ('ipt', 'ip')"/>
                            <field name="address_id" string="IP" options="{'no_create': True}" invisible="service_type != 'ip_single'"/>
                            <field name="line_id" string="线路" options="{'no_create': True}" invisible="service_type not in ('pl', 'sdwan', 'line')"/>
                            <field name="resource_ref" column_invisible="1"/>
                        </list>
                    </field>
                    <field name="resource_note"/>
                    <separator string="割接通知" invisible="move != 'cutover'"/>
                    <group invisible="move != 'cutover'">
                        <field name="reason"/>
                        <field name="impact"/>
                        <field name="notice_subject"/>
                        <field name="notice_body"/>
                    </group>
                    <separator string="交付任务"/>
                    <field name="task_progress" widget="progressbar" class="mb-2"/>

                    <field name="task_ids" nolabel="1" context="{'default_flow_id': id}">
                        <list editable="bottom" decoration-success="state == 'done'" decoration-muted="state == 'skipped'" decoration-danger="state == 'blocked' or overdue" decoration-info="state == 'doing'">
                            <field name="sequence" widget="handle"/>
                            <field name="stage"/>
                            <field name="name"/>
                            <field name="priority" widget="priority"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="planned_start" optional="hide"/>
                            <field name="due_date"/>
                            <field name="state" widget="badge" decoration-success="state == 'done'" decoration-info="state == 'doing'" decoration-danger="state == 'blocked'" decoration-muted="state in ('todo', 'skipped')"/>
                            <field name="depends_on_id" optional="hide"/>
                            <field name="blocker" optional="show"/>
                            <field name="estimate_hours" optional="hide" sum="合计"/>
                            <field name="actual_start" optional="hide"/>
                            <field name="done_at" optional="hide"/>
                            <field name="overdue" column_invisible="1"/>
                            <field name="done" column_invisible="1"/>
                            <button name="action_start" type="object" icon="fa-play" title="开始" invisible="state != 'todo'"/>
                            <button name="action_done" type="object" icon="fa-check" title="完成" invisible="state in ('done', 'skipped')"/>
                            <button name="action_block" type="object" icon="fa-ban" title="阻塞" invisible="state in ('blocked', 'done', 'skipped')"/>
                            <button name="action_reopen" type="object" icon="fa-undo" title="重开" invisible="state not in ('done', 'skipped', 'blocked')"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_flow_search" model="ir.ui.view">
        <field name="name">zenlenet.flow.search</field>
        <field name="model">zenlenet.flow</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <filter name="mine" string="我的" domain="['|', '|', '|', '|', '|', ('user_id', '=', uid), ('sales_user_id', '=', uid), ('allocator_user_id', '=', uid), ('delivery_user_id', '=', uid), ('service_user_id', '=', uid), ('procurement_user_id', '=', uid)]"/>
                <filter name="sales" string="销售" domain="[('team', '=', 'sales')]"/>
                <filter name="allocator" string="资源" domain="[('team', '=', 'allocator')]"/>
                <filter name="delivery" string="交付" domain="[('team', '=', 'delivery')]"/>
                <filter name="service" string="售后" domain="[('team', '=', 'service')]"/>
                <filter name="procurement" string="采购" domain="[('team', '=', 'procurement')]"/>
                <filter name="move_out" string="出：开通" domain="[('move', '=', 'out')]"/>
                <filter name="move_in" string="进：入库" domain="[('move', '=', 'in')]"/>
                <filter name="move_back" string="退：退回" domain="[('move', '=', 'back')]"/>
                <filter name="move_cutover" string="割接" domain="[('move', '=', 'cutover')]"/>
                <filter name="test" string="测试" domain="[('kind', '=', 'test')]"/>
                <filter name="business" string="商务" domain="[('kind', '=', 'business')]"/>
                <filter name="open" string="未完成" domain="[('state', 'not in', ('done', 'cancel'))]"/>
                <filter name="risky" string="有风险 / 阻塞" domain="[('risk', '!=', 'normal'), ('state', 'not in', ('done', 'cancel'))]"/>
                <filter name="my_pm" string="我负责的项目" domain="[('pm_user_id', '=', uid)]"/>
            </search>
        </field>
    </record>
    <record id="view_allocation_queue_list" model="ir.ui.view">
        <field name="name">zenlenet.allocation.queue</field>
        <field name="model">zenlenet.flow.resource</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="0" decoration-success="resource_ref" decoration-warning="not resource_ref">
                <header>
                    <button name="action_suggest" type="object" string="自动推荐" class="btn-secondary"/>
                    <button name="action_finish_allocation" type="object" string="这一步完成，推进工单" class="btn-primary" groups="zenlenet_ops.group_allocator"/>
                </header>
                <field name="flow_id" readonly="1" string="交付工单"/>
                <field name="partner_id" readonly="1" string="客户"/>
                <field name="order_id" readonly="1" string="订单"/>
                <field name="datacenter_id" readonly="1" string="期望机房"/>
                <field name="service_type" readonly="1" string="业务"/>
                <field name="spec" readonly="1" string="需求"/>
                <field name="prefix_id" string="网段" options="{'no_create': True}" domain="[('partner_id', '=', False), ('child_ids', '=', False), ('status', 'in', ('active', 'reserved'))]" invisible="service_type not in ('ipt', 'ip')"/>
                <field name="address_id" string="IP" options="{'no_create': True}" domain="[('status', '=', 'free')]" invisible="service_type != 'ip_single'"/>
                <field name="line_id" string="线路" options="{'no_create': True}" domain="[('partner_id', '=', False), ('status', 'in', ('planned', 'provisioning', 'active'))]" invisible="service_type not in ('pl', 'sdwan', 'line')"/>
                <field name="resource_ref" column_invisible="1"/>
                <field name="flow_user_id" readonly="1" widget="many2one_avatar_user" string="交付"/>
                <field name="flow_state" column_invisible="1"/>
                <field name="needs_resource" column_invisible="1"/>
                <button name="action_suggest" type="object" icon="fa-magic" title="推荐一个空闲资源" invisible="resource_ref"/>
                <button name="action_open_flow" type="object" icon="fa-external-link" title="打开交付工单"/>
            </list>
        </field>
    </record>
    <record id="view_allocation_queue_search" model="ir.ui.view">
        <field name="name">zenlenet.allocation.queue.search</field>
        <field name="model">zenlenet.flow.resource</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="flow_id"/>
                <filter name="pending" string="待分配" domain="[('resource_ref', '=', False)]"/>
                <filter name="done" string="已分配" domain="[('resource_ref', '!=', False)]"/>
                <group>
                    <filter name="group_flow" string="交付工单" context="{'group_by': 'flow_id'}"/>
                    <filter name="group_dc" string="期望数据中心" context="{'group_by': 'datacenter_id'}"/>
                </group>
                <searchpanel>
                    <field name="datacenter_id" string="期望数据中心" enable_counters="1" icon="fa-building" limit="60"/>
                    <field name="service_type" string="业务" enable_counters="1" expand="1" icon="fa-tag"/>
                </searchpanel>
            </search>
        </field>
    </record>
    <record id="action_allocation_queue" model="ir.actions.act_window">
        <field name="name">资源分配</field>
        <field name="res_model">zenlenet.flow.resource</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_allocation_queue_list"/>
        <field name="search_view_id" ref="view_allocation_queue_search"/>
        <field name="domain">[('flow_state', '=', 'allocate'), ('needs_resource', '=', True)]</field>
        <field name="context">{'search_default_pending': 1, 'search_default_group_flow': 1}</field>
    </record>
    <record id="view_flow_task_kanban" model="ir.ui.view">
        <field name="name">zenlenet.flow.task.kanban</field>
        <field name="model">zenlenet.flow.task</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false" highlight_color="color" class="o_kanban_small_column">
                <field name="state"/><field name="color"/><field name="overdue"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <span class="fw-bold"><field name="name"/></span>
                            <field name="priority" widget="priority"/>
                        </div>
                        <div class="text-muted small"><field name="flow_id"/> · <field name="partner_id"/> · <field name="stage"/></div>
                        <div t-if="record.blocker.raw_value" class="text-danger small"><i class="fa fa-ban" title="阻塞"/> <field name="blocker"/></div>
                        <div class="d-flex justify-content-between align-items-center mt-1">
                            <span class="small" t-attf-class="#{record.overdue.raw_value ? 'text-danger fw-bold' : 'text-muted'}"><i class="fa fa-calendar-o" title="计划完成"/> <field name="due_date"/></span>
                            <field name="user_id" widget="many2one_avatar_user"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="view_flow_task_list" model="ir.ui.view">
        <field name="name">zenlenet.flow.task.list</field>
        <field name="model">zenlenet.flow.task</field>
        <field name="arch" type="xml">
            <list editable="bottom" decoration-danger="overdue or state == 'blocked'" decoration-success="state == 'done'" decoration-muted="state == 'skipped'">
                <field name="flow_id" readonly="1"/>
                <field name="partner_id" readonly="1"/>
                <field name="stage"/>
                <field name="name"/>
                <field name="priority" widget="priority"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="planned_start" optional="hide"/>
                <field name="due_date"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-info="state == 'doing'" decoration-danger="state == 'blocked'"/>
                <field name="blocker" optional="show"/>
                <field name="estimate_hours" optional="hide" sum="合计"/>
                <field name="done_at" optional="hide"/>
                <field name="overdue" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="view_flow_task_calendar" model="ir.ui.view">
        <field name="name">zenlenet.flow.task.calendar</field>
        <field name="model">zenlenet.flow.task</field>
        <field name="arch" type="xml">
            <calendar date_start="due_date" color="flow_id" quick_create="0" event_open_popup="1">
                <field name="flow_id"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>
    <record id="view_flow_task_search" model="ir.ui.view">
        <field name="name">zenlenet.flow.task.search</field>
        <field name="model">zenlenet.flow.task</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="flow_id"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <filter name="mine" string="我的任务" domain="[('user_id', '=', uid)]"/>
                <filter name="open" string="未完成" domain="[('state', 'not in', ('done', 'skipped'))]"/>
                <filter name="overdue" string="已逾期" domain="[('overdue', '=', True)]"/>
                <filter name="blocked" string="阻塞" domain="[('state', '=', 'blocked')]"/>
                <group>
                    <filter name="group_flow" string="交付工单" context="{'group_by': 'flow_id'}"/>
                    <filter name="group_user" string="负责人" context="{'group_by': 'user_id'}"/>
                    <filter name="group_stage" string="阶段" context="{'group_by': 'stage'}"/>
                </group>
                <searchpanel>
                    <field name="user_id" string="负责人" enable_counters="1" icon="fa-user" limit="30"/>
                    <field name="stage" string="阶段" enable_counters="1" expand="1" icon="fa-flag"/>
                </searchpanel>
            </search>
        </field>
    </record>
    <record id="action_flow_tasks" model="ir.actions.act_window">
        <field name="name">交付任务</field>
        <field name="res_model">zenlenet.flow.task</field>
        <field name="view_mode">kanban,list,calendar</field>
        <field name="search_view_id" ref="view_flow_task_search"/>
        <field name="domain">[('flow_id.state', 'not in', ('done', 'cancel'))]</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>
    <record id="view_task_template_list" model="ir.ui.view">
        <field name="name">zenlenet.task.template.list</field>
        <field name="model">zenlenet.task.template</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="service_type"/>
                <field name="stage"/>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="team"/>
