<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_list" model="ir.ui.view">
        <field name="name">zenlenet.purchase.list</field>
        <field name="model">zenlenet.purchase</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'returned'" decoration-success="state == 'received'">
                <field name="name"/>
                <field name="category"/>
                <field name="supplier_id"/>
                <field name="resource"/>
                <field name="datacenter_id"/>
                <field name="quantity" optional="hide"/>
                <field name="monthly_cost" sum="合计"/>
                <field name="one_time_cost" optional="hide" sum="合计"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="expected_on" optional="show"/>
                <field name="end_on" optional="hide"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'ordered'" decoration-success="state == 'received'"/>
            </list>
        </field>
    </record>
    <record id="view_purchase_form" model="ir.ui.view">
        <field name="name">zenlenet.purchase.form</field>
        <field name="model">zenlenet.purchase</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_order" type="object" string="已下单" class="btn-primary" invisible="state != 'draft'" groups="zenlenet_ops.group_procurement,zenlenet_ops.group_manager"/>
                    <button name="action_receive" type="object" string="已到货" class="btn-primary" invisible="state != 'ordered'" groups="zenlenet_ops.group_procurement,zenlenet_ops.group_manager"/>
                    <button name="action_make_bill" type="object" string="生成供应商账单" invisible="bill_id or state not in ('ordered', 'received')" groups="zenlenet_ops.group_procurement,zenlenet_ops.group_manager"/>
                    <button name="action_return" type="object" string="退回供应商" invisible="state != 'received'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,ordered,received"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <h2><field name="resource"/></h2>
                    </div>
                    <group>
                        <group string="采购">
                            <field name="category"/>
                            <field name="supplier_id" options="{'no_create': True}"/>
                            <field name="datacenter_id"/>
                            <field name="bill_id" invisible="not bill_id"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                        </group>
                        <group string="费用">
                            <field name="currency_id"/>
                            <field name="quantity"/>
                            <field name="unit"/>
                            <field name="unit_cost"/>
                            <field name="monthly_cost"/>
                            <field name="one_time_cost"/>
                            <field name="term_months"/>
                        </group>
                        <group string="时间">
                            <field name="ordered_on"/>
                            <field name="expected_on"/>
                            <field name="received_on"/>
                            <field name="end_on"/>
                        </group>
                    </group>
                    <field name="note"/>
                    <separator string="供应商账单" invisible="not bill_id"/>
                    <group invisible="not bill_id">
                        <field name="bill_residual"/>
                        <field name="bill_payment_state"/>
                    </group>
                    <field name="bill_line_ids" nolabel="1" readonly="1" invisible="not bill_id">
                        <list>
                            <field name="name" string="项目"/>
                            <field name="quantity" string="数量"/>
                            <field name="price_unit" string="单价"/>
                            <field name="price_subtotal" string="金额"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="display_type" column_invisible="1"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_purchase_search" model="ir.ui.view">
        <field name="name">zenlenet.purchase.search</field>
        <field name="model">zenlenet.purchase</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="supplier_id"/>
                <field name="resource"/>
                <filter name="open" string="进行中" domain="[('state', 'in', ('draft', 'ordered'))]"/>
                <filter name="received" string="已到货" domain="[('state', '=', 'received')]"/>
                <group>
                    <filter name="group_category" string="类别" context="{'group_by': 'category'}"/>
                    <filter name="group_supplier" string="供应商" context="{'group_by': 'supplier_id'}"/>
                    <filter name="group_state" string="状态" context="{'group_by': 'state'}"/>
                </group>
                <searchpanel>
                    <field name="category" string="采购类别" enable_counters="1" expand="1" icon="fa-tags"/>
                    <field name="supplier_id" string="供应商" enable_counters="1" icon="fa-truck" limit="40"/>
                    <field name="state" string="状态" enable_counters="1" expand="1" icon="fa-flag"/>
                    <field name="datacenter_id" string="数据中心" enable_counters="1" icon="fa-building" limit="60"/>
                </searchpanel>
            </search>
        </field>
    </record>
    <record id="action_purchases" model="ir.actions.act_window">
        <field name="name">采购</field>
        <field name="res_model">zenlenet.purchase</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_purchase_search"/>
        <field name="context">{'search_default_open': 1}</field>
    </record>
</odoo>
