<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_list" model="ir.ui.view">
        <field name="name">zenlenet.purchase.list</field>
        <field name="model">zenlenet.purchase</field>
        <field name="arch" type="xml">
            <list>
                <field name="supplier"/>
                <field name="resource"/>
                <field name="pop"/>
                <field name="user_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_purchase_form" model="ir.ui.view">
        <field name="name">zenlenet.purchase.form</field>
        <field name="model">zenlenet.purchase</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="supplier"/>
                        <field name="resource"/>
                        <field name="pop"/>
                        <field name="user_id"/>
                        <field name="state"/>
                    </group>
                    <field name="note" placeholder="备注"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_purchases" model="ir.actions.act_window">
        <field name="name">采购管理</field>
        <field name="res_model">zenlenet.purchase</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
