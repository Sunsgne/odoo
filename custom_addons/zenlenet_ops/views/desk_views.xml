<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_desk_kanban" model="ir.ui.view">
        <field name="name">zenlenet.desk.kanban</field>
        <field name="model">zenlenet.desk</field>
        <field name="arch" type="xml">
            <kanban create="0" records_draggable="0" action="action_open" type="object">
                <field name="name"/>
                <field name="hint"/>
                <templates>
                    <t t-name="card">
                        <div class="p-2">
                            <div class="fw-bold fs-4"><field name="name"/></div>
                            <div class="text-muted"><field name="hint"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="action_desk" model="ir.actions.act_window">
        <field name="name">尊领</field>
        <field name="res_model">zenlenet.desk</field>
        <field name="view_mode">kanban</field>
        <field name="target">current</field>
    </record>
    <record id="desk_flow" model="zenlenet.desk">
        <field name="name">业务流转</field>
        <field name="sequence">5</field>
        <field name="hint">销售录入公司，交付分配资源，售后验收。测试要回收或转商务</field>
        <field name="action_ref">zenlenet_ops.action_flow</field>
    </record>
    <record id="desk_customers" model="zenlenet.desk">
        <field name="name">客户管理</field>
        <field name="sequence">10</field>
        <field name="hint">在网、测试、已退租</field>
        <field name="action_ref">zenlenet_ops.action_customers</field>
    </record>
    <record id="desk_orders" model="zenlenet.desk">
        <field name="name">订单管理</field>
        <field name="sequence">20</field>
        <field name="hint">IPT、专线、云主机、托管、转售</field>
        <field name="action_ref">zenlenet_ops.action_orders</field>
    </record>
    <record id="desk_invoices" model="zenlenet.desk">
        <field name="name">出账</field>
        <field name="sequence">30</field>
        <field name="hint">按客户汇总。单价是演示价目，不是合同价</field>
        <field name="action_ref">zenlenet_ops.action_invoices</field>
    </record>
    <record id="desk_addresses" model="zenlenet.desk">
        <field name="name">资源管理</field>
        <field name="sequence">40</field>
        <field name="hint">IP、线路、退资源</field>
        <field name="action_ref">zenlenet_ops.action_addresses</field>
    </record>
    <record id="desk_blocks" model="zenlenet.desk">
        <field name="name">库存管理</field>
        <field name="sequence">70</field>
        <field name="hint">还没分出去的地址</field>
        <field name="action_ref">zenlenet_ops.action_stock</field>
    </record>
    <record id="desk_lines" model="zenlenet.desk">
        <field name="name">采购管理</field>
        <field name="sequence">60</field>
        <field name="hint">待采购、已下单、已到货</field>
        <field name="action_ref">zenlenet_ops.action_purchases</field>
    </record>
    <record id="desk_returns" model="zenlenet.desk">
        <field name="name">固定资产</field>
        <field name="sequence">80</field>
        <field name="hint">在用、闲置、报废</field>
        <field name="action_ref">zenlenet_ops.action_assets</field>
    </record>
    <record id="desk_maintenance" model="zenlenet.desk">
        <field name="name">数据中心维护</field>
        <field name="sequence">50</field>
        <field name="hint">割接和维护通知</field>
        <field name="action_ref">zenlenet_ops.action_maintenance</field>
    </record>
    <record id="desk_settings" model="zenlenet.desk">
        <field name="name">系统设置</field>
        <field name="sequence">90</field>
        <field name="hint">账号</field>
        <field name="action_ref">zenlenet_ops.action_users</field>
    </record>
    <record id="desk_templates" model="zenlenet.desk">
        <field name="name">通知模板</field>
        <field name="sequence">100</field>
        <field name="hint">维护、割接、风险、紧急、接入点</field>
        <field name="action_ref">zenlenet_ops.action_templates</field>
    </record>
</odoo>
