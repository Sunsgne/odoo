<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_address_list" model="ir.ui.view">
        <field name="name">zenlenet.address.list</field>
        <field name="model">zenlenet.address</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button name="action_export_prefixes" type="object" string="导出地址段" display="always"/>
                    <button name="action_merge" type="object" string="合并为地址集" display="always"/>
                    <button name="action_add_ipset" type="object" string="新增地址集" display="always"/>
                    <button name="action_add_prefix" type="object" string="新增地址段" class="btn-primary" display="always"/>
                </header>
                <field name="address" class="font-monospace"/>
                <field name="prefix_id" string="地址段" optional="show"/>
                <field name="block" optional="hide"/>
                <field name="datacenter_id"/>
                <field name="pop" optional="hide"/>
                <field name="partner_id"/>
                <field name="status" widget="badge" decoration-success="status == 'allocated'" decoration-info="status == 'free'" decoration-warning="status in ('reserved', 'transferring', 'returning')" decoration-muted="status == 'internal'"/>
                <field name="net_attr"/>
                <field name="dc_type" optional="show"/>
                <field name="role" optional="show"/>
                <field name="supplier_id" optional="hide"/>
                <field name="usage" optional="hide"/>
                <field name="expires_on" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_address_form" model="ir.ui.view">
        <field name="name">zenlenet.address.form</field>
        <field name="model">zenlenet.address</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_netbox" type="object" string="在 NetBox 中查看" icon="fa-external-link" invisible="not netbox_id"/>
                    <field name="status" widget="statusbar" options="{'clickable': true}" statusbar_visible="free,reserved,allocated,returning"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="address" class="font-monospace"/>
                            <field name="prefix_id"/>
                            <field name="block" invisible="1"/>
                            <field name="datacenter_id"/>
                            <field name="pop"/>
                            <field name="partner_id"/>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="net_attr"/>
                            <field name="dc_type"/>
                            <field name="role"/>
                            <field name="supplier_id" options="{'no_create': True}"/>
                            <field name="usage"/>
                            <field name="expires_on"/>
                        </group>
                    </group>
                    <field name="remark" placeholder="备注"/>
                    <notebook>
                        <page string="交付记录">
                            <field name="allocation_ids" readonly="1">
                                <list>
                                    <field name="flow_id"/>
                                    <field name="order_id"/>
                                    <field name="partner_id"/>
                                    <field name="spec"/>
                                    <field name="flow_state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group string="NetBox" invisible="not netbox_id">
                        <field name="netbox_id"/>
                        <field name="netbox_synced"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_address_search" model="ir.ui.view">
        <field name="name">zenlenet.address.search</field>
        <field name="model">zenlenet.address</field>
        <field name="arch" type="xml">
            <search>
                <field name="address"/>
                <field name="block"/>
                <field name="partner_id"/>
                <field name="pop"/>
                <field name="supplier"/>
                <filter name="allocated" string="已分配" domain="[('status','=','allocated')]"/>
                <filter name="free" string="未分配" domain="[('status','=','free')]"/>
                <filter name="reserved" string="预分配" domain="[('status','=','reserved')]"/>
                <filter name="transferring" string="调库中" domain="[('status','=','transferring')]"/>
                <filter name="returning" string="出库中" domain="[('status','=','returning')]"/>
                <filter name="testing" string="测试" domain="[('status','=','testing')]"/>
                <filter name="internal" string="自用" domain="[('status','=','internal')]"/>
                <separator/>
                <filter name="dc_returned" string="已退租" domain="[('dc_type','=','已退租')]"/>
                <filter name="dc_rare" string="不常用" domain="[('dc_type','=','不常用')]"/>
                <filter name="dc_main" string="主营机房" domain="[('dc_type','=','主营机房')]"/>
                <filter name="dc_an" string="安畅云" domain="[('dc_type','=','安畅云')]"/>
                <filter name="dc_third" string="第三方" domain="[('dc_type','=','第三方')]"/>
                <filter name="dc_pop" string="POP点" domain="[('dc_type','=','POP点')]"/>
                <filter name="dc_cloud" string="公有云" domain="[('dc_type','=','公有云')]"/>
                <separator/>
                <filter name="fastfiber" string="FastFiber" domain="[('net_attr','=','FastFiber')]"/>
                <filter name="public_net" string="公网" domain="[('net_attr','=','公网')]"/>
                <filter name="private_net" string="内网" domain="[('net_attr','=','内网')]"/>
                <group>
                    <filter name="group_prefix" string="地址段" context="{'group_by': 'prefix_id'}"/>
                    <filter name="group_block" string="IP段（旧）" context="{'group_by': 'block'}"/>
                    <filter name="group_pop" string="机房" context="{'group_by': 'pop'}"/>
                    <filter name="group_status" string="分配状态" context="{'group_by': 'status'}"/>
                    <filter name="group_dc" string="数据中心类型" context="{'group_by': 'dc_type'}"/>
                </group>
                <searchpanel>
                    <field name="datacenter_id" string="数据中心" enable_counters="1" icon="fa-building" limit="60"/>
                    <field name="dc_type" string="数据中心类型" enable_counters="1" expand="1" icon="fa-tag"/>
                    <field name="status" string="分配状态" enable_counters="1" expand="1" icon="fa-tags"/>
                    <field name="net_attr" string="网络属性" enable_counters="1" expand="1" icon="fa-globe"/>
                </searchpanel>
            </search>
        </field>
    </record>
    <record id="action_addresses" model="ir.actions.act_window">
        <field name="name">IP 地址</field>
        <field name="res_model">zenlenet.address</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_address_search"/>
        <field name="context">{'search_default_group_prefix': 1}</field>
            </record>
    <record id="action_blocks" model="ir.actions.act_window">
        <field name="name">按地址段查看</field>
        <field name="res_model">zenlenet.address</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_address_search"/>
        <field name="context">{'search_default_group_block': 1}</field>
    </record>
    <record id="action_stock" model="ir.actions.act_window">
        <field name="name">可用地址</field>
        <field name="res_model">zenlenet.address</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('status', '=', 'free')]</field>
        <field name="search_view_id" ref="view_address_search"/>
    </record>
    <record id="action_prefix_export" model="ir.actions.act_url">
        <field name="name">导出地址段</field>
        <field name="url">/zenlenet/prefixes.csv</field>
        <field name="target">new</field>
    </record>
</odoo>
