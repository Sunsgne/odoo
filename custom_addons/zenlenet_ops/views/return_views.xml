<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_return_list" model="ir.ui.view">
        <field name="name">zenlenet.supplier.return.list</field>
        <field name="model">zenlenet.supplier.return</field>
        <field name="arch" type="xml">
            <list>
                <field name="supplier"/>
                <field name="resource"/>
                <field name="when_text"/>
                <field name="note"/>
            </list>
        </field>
    </record>
    <record id="view_return_form" model="ir.ui.view">
        <field name="name">zenlenet.supplier.return.form</field>
        <field name="model">zenlenet.supplier.return</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="supplier"/>
                        <field name="resource"/>
                        <field name="when_text"/>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_returns" model="ir.actions.act_window">
        <field name="name">退资源</field>
        <field name="res_model">zenlenet.supplier.return</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
