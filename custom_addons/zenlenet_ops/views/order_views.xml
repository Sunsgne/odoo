<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_zenlenet" model="ir.ui.view">
        <field name="name">sale.order.form.zenlenet</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//header" position="replace">
                <header>
                    <button name="action_print_quote" type="object" string="打印报价单" invisible="state not in ('draft', 'sent')"/>
                    <button name="action_confirm" type="object" string="确认成订单" class="btn-primary" invisible="state not in ('draft', 'sent')"/>
                    <button name="action_make_contract" type="object" string="生成合同" invisible="state != 'sale'"/>
                    <button name="action_mark_active" type="object" string="在网" class="btn-primary" invisible="zenlenet_stage == 'active' or state in ('draft', 'sent')"/>
                    <button name="action_mark_testing" type="object" string="测试" invisible="zenlenet_stage == 'testing' or state in ('draft', 'sent')"/>
                    <button name="action_mark_terminated" type="object" string="已退租" invisible="zenlenet_stage == 'terminated' or state in ('draft', 'sent')"/>
                    <field name="zenlenet_stage" widget="statusbar" statusbar_visible="testing,active,terminated" invisible="state in ('draft', 'sent')"/>
                    <field name="state" invisible="1"/>
                    <field name="locked" invisible="1"/>
                </header>
            </xpath>
            <xpath expr="//page[@name='other_information']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='customer_signature']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_invoice_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_shipping_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='payment_term_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//label[@for='pricelist_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='pricelist_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='tax_ids']" position="attributes">
                <attribute name="column_invisible">1</attribute>
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='tax_ids' and @optional='show']" position="attributes">
                <attribute name="column_invisible">1</attribute>
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='validity_date']" position="attributes">
                <attribute name="invisible">state not in ('draft', 'sent')</attribute>
                <attribute name="string">报价有效期</attribute>
            </xpath>
            <xpath expr="//button[@name='action_update_prices']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='tax_totals']" position="replace">
                <field name="amount_untaxed" string="月费"/>
            </xpath>
            <xpath expr="//chatter" position="replace"/>
            <xpath expr="//field[@name='discount']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='note']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
    <record id="view_order_list" model="ir.ui.view">
        <field name="name">zenlenet.order.list</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" string="单号"/>
                <field name="partner_id" string="客户"/>
                <field name="origin" string="业务"/>
                <field name="amount_untaxed" string="月费"/>
                <field name="currency_id" string="币种"/>
                <field name="zenlenet_stage"/>
                <field name="date_order" string="日期" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_order_search_zenlenet" model="ir.ui.view">
        <field name="name">zenlenet.order.search</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="origin"/>
                <field name="name"/>
                <filter name="stage_active" string="在网" domain="[('zenlenet_stage','=','active')]"/>
                <filter name="stage_testing" string="测试" domain="[('zenlenet_stage','=','testing')]"/>
                <filter name="stage_terminated" string="已退租" domain="[('zenlenet_stage','=','terminated')]"/>
            </search>
        </field>
    </record>
    <record id="action_orders" model="ir.actions.act_window">
        <field name="name">服务订单</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_order_search_zenlenet"/>
        <field name="view_id" ref="view_order_list"/>
    </record>
</odoo>
