<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_contract_list" model="ir.ui.view">
        <field name="name">zenlenet.contract.list</field>
        <field name="model">zenlenet.contract</field>
        <field name="arch" type="xml">
            <list decoration-warning="state == 'expiring'" decoration-danger="state == 'expired'" decoration-muted="state == 'terminated'">
                <header>
                    <button name="action_bill_period" type="object" string="生成本月账单" class="btn-primary" display="always" groups="zenlenet_ops.group_finance,zenlenet_ops.group_manager"/>
                </header>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="title" optional="hide"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="days_left"/>
                <field name="billing_cycle"/>
                <field name="monthly_amount"/>
                <field name="one_time_total" optional="show"/>
                <field name="currency_id" string="币种"/>
                <field name="sales_user_id" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge" decoration-success="state == 'active'" decoration-warning="state == 'expiring'" decoration-danger="state == 'expired'"/>
            </list>
        </field>
    </record>
    <record id="view_contract_form" model="ir.ui.view">
        <field name="name">zenlenet.contract.form</field>
        <field name="model">zenlenet.contract</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" type="object" string="开始执行" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_bill_now" type="object" string="出本期账单" class="btn-primary" invisible="state not in ('active', 'expiring')" groups="zenlenet_ops.group_finance,zenlenet_ops.group_manager"/>
                    <button name="action_load_items" type="object" string="从订单带入费用" invisible="not order_ids or state not in ('draft', 'active', 'expiring')"/>
                    <button name="%(zenlenet_ops.report_contract)d" type="action" string="打印合同"/>
                    <button name="action_renew" type="object" string="续签一期" invisible="state not in ('expiring', 'expired')"/>
                    <button name="action_terminate" type="object" string="终止" invisible="state in ('terminated', 'draft')"/>
                    <button name="action_reset" type="object" string="改回草稿" invisible="state != 'terminated'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,expiring,expired"/>
                </header>
                <sheet>
                    <div class="o_zl_chain">
                        <div class="o_zl_chain_step"><b><field name="monthly_amount" widget="monetary"/></b><span>月费</span></div>
                        <div class="o_zl_chain_step"><b><field name="one_time_total" widget="monetary"/></b><span>一次性</span></div>
                        <div class="o_zl_chain_step"><b><field name="invoice_count"/></b><span>账单</span></div>
                        <div class="o_zl_chain_step"><b><field name="days_left"/></b><span>剩余天数</span></div>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <h2><field name="title"/></h2>
                    </div>
                    <group>
                        <group string="客户与期限">
                            <field name="partner_id" readonly="state != 'draft'" context="{'form_view_ref': 'zenlenet_ops.view_partner_form_simple', 'list_view_ref': 'zenlenet_ops.view_partner_list'}"/>
                            <field name="start_date"/>
                            <field name="term_months"/>
                            <field name="end_date"/>
                            <field name="days_left" invisible="state in ('draft', 'terminated')"/>
                            <field name="auto_renew"/>
                            <field name="signed_on"/>
                        </group>
                        <group string="费用">
                            <field name="billing_cycle" string="默认周期"/>
                            <field name="monthly_amount"/>
                            <field name="cycle_amount"/>
                            <field name="one_time_total"/>
                            <field name="one_time_billed" invisible="not one_time_total"/>
                            <field name="sales_user_id"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <separator string="费用条款"/>
                    <field name="item_ids" nolabel="1">
                        <list editable="bottom" decoration-muted="billed">
                            <field name="sequence" widget="handle"/>
                            <field name="kind"/>
                            <field name="name"/>
                            <field name="product_id" optional="show"/>
                            <field name="cycle" invisible="kind != 'recurring'"/>
                            <field name="quantity"/>
                            <field name="price_unit"/>
                            <field name="amount" sum="合计"/>
                            <field name="p95" optional="show" invisible="kind != 'recurring'"/>
                            <field name="start_date" optional="show"/>
                            <field name="end_date" optional="show"/>
                            <field name="billed" invisible="kind != 'one_time'" readonly="1"/>
                            <field name="invoice_id" optional="hide" readonly="1"/>
                            <field name="order_line_id" column_invisible="1"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                    <separator string="订单"/>
                    <field name="order_ids" nolabel="1" context="{'list_view_ref': 'zenlenet_ops.view_order_list'}" options="{'no_create': True}">
                        <list limit="20">
                            <field name="name" string="单号"/>
                            <field name="origin" string="业务"/>
                            <field name="amount_untaxed" string="月费"/>
                            <field name="zenlenet_stage"/>
                        </list>
                    </field>
                    <separator string="交付"/>
                    <field name="flow_ids" readonly="1" nolabel="1">
                        <list limit="20">
                            <field name="name"/>
                            <field name="order_id"/>
                            <field name="state" widget="badge"/>
                            <field name="datacenter_id"/>
                            <field name="pending_count" string="待分配"/>
                            <field name="planned_date"/>
                        </list>
                    </field>
                    <separator string="账单"/>
                    <field name="invoice_ids" readonly="1" nolabel="1">
                        <list limit="20">
                            <field name="name" string="账单"/>
                            <field name="ref" string="账期"/>
                            <field name="invoice_date" string="日期"/>
                            <field name="amount_total" string="金额" sum="合计"/>
                            <field name="amount_residual" string="未收" sum="合计"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="state" widget="badge"/>
                            <field name="payment_state" string="收款" widget="badge"/>
                        </list>
                    </field>
                    <separator string="补充条款"/>
                    <field name="terms" nolabel="1"/>
                    <separator string="备注"/>
                    <field name="note" nolabel="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_contract_search" model="ir.ui.view">
        <field name="name">zenlenet.contract.search</field>
        <field name="model">zenlenet.contract</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <filter name="running" string="执行中" domain="[('state', 'in', ('active', 'expiring'))]"/>
                <filter name="expiring" string="即将到期" domain="[('state', '=', 'expiring')]"/>
                <filter name="expired" string="已到期" domain="[('state', '=', 'expired')]"/>
                <filter name="draft" string="草稿" domain="[('state', '=', 'draft')]"/>
                <group>
                    <filter name="group_state" string="状态" context="{'group_by': 'state'}"/>
                    <filter name="group_cycle" string="出账周期" context="{'group_by': 'billing_cycle'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_contracts" model="ir.actions.act_window">
        <field name="name">合同</field>
        <field name="res_model">zenlenet.contract</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_contract_search"/>
    </record>
    <record id="action_quotes" model="ir.actions.act_window">
        <field name="name">报价</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', 'in', ('draft', 'sent')), ('zenlenet_stage', '=', False)]</field>
        <field name="context">{'default_state': 'draft'}</field>
        <field name="search_view_id" ref="view_order_search_zenlenet"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_order_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_quote_form')})]"/>
    </record>
</odoo>
