<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ipset_list" model="ir.ui.view">
        <field name="name">zenlenet.ipset.list</field>
        <field name="model">zenlenet.ipset</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="pop"/>
                <field name="net_attr"/>
                <field name="dc_type"/>
            </list>
        </field>
    </record>
    <record id="view_ipset_form" model="ir.ui.view">
        <field name="name">zenlenet.ipset.form</field>
        <field name="model">zenlenet.ipset</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="IP集名称"/></h1>
                    </div>
                    <group>
                        <field name="pop"/>
                        <field name="net_attr"/>
                        <field name="dc_type"/>
                    </group>
                    <field name="address_ids">
                        <list>
                            <field name="address"/>
                            <field name="block"/>
                            <field name="pop"/>
                            <field name="status"/>
                        </list>
                    </field>
                    <field name="note" placeholder="备注"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_ipsets" model="ir.actions.act_window">
        <field name="name">IP集</field>
        <field name="res_model">zenlenet.ipset</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="view_prefix_add_form" model="ir.ui.view">
        <field name="name">zenlenet.prefix.add.form</field>
        <field name="model">zenlenet.prefix.add</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="cidr" placeholder="192.0.2.0/24"/>
                        <field name="parent_id" options="{'no_create': True}"/>
                        <field name="datacenter_id" options="{'no_create': True}"/>
                        <field name="status"/>
                    </group>
                    <group>
                        <field name="region"/>
                        <field name="asn"/>
                        <field name="partner_id" options="{'no_create': True}"/>
                        <field name="supplier_id" options="{'no_create': True}"/>
                        <field name="role"/>
                        <field name="description"/>
                    </group>
                </group>
                <footer>
                    <button name="action_create" type="object" string="录入" class="btn-primary"/>
                    <button special="cancel" string="取消"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_prefix_add" model="ir.actions.act_window">
        <field name="name">录入网段</field>
        <field name="res_model">zenlenet.prefix.add</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
