<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_zenlenet" model="ir.module.category">
        <field name="name">运营后台</field>
        <field name="sequence">1</field>
    </record>
    <record id="privilege_zenlenet" model="res.groups.privilege">
        <field name="name">运营后台</field>
        <field name="sequence">1</field>
        <field name="category_id" ref="module_category_zenlenet"/>
    </record>

    <!-- 岗位：每个岗位只拿到自己那部分的写权限，其余只读。 -->
    <record id="group_sales" model="res.groups">
        <field name="name">销售</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_zenlenet"/>
        <field name="comment">客户、报价、订单、合同草稿、交付工单的录入公司阶段。</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
    </record>
    <record id="group_delivery" model="res.groups">
        <field name="name">交付</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_zenlenet"/>
        <field name="comment">数据中心、网段、IP、线路的分配与回收，交付工单的分配资源和交付阶段。</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_allocator" model="res.groups">
        <field name="name">资源分配</field>
        <field name="sequence">25</field>
        <field name="privilege_id" ref="privilege_zenlenet"/>
        <field name="comment">专门分资源的人：处理待分配队列，给交付工单挂网段、IP、线路，可回收网段。</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_pm" model="res.groups">
        <field name="name">项目经理</field>
        <field name="sequence">28</field>
        <field name="privilege_id" ref="privilege_zenlenet"/>
        <field name="comment">对整个交付负责：跨阶段调整任务、计划日期和负责人，维护交付任务模板。</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_service" model="res.groups">
        <field name="name">售后</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="privilege_zenlenet"/>
        <field name="comment">服务工单、维护通告、交付验收与测试回收。</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_finance" model="res.groups">
        <field name="name">财务</field>
        <field name="sequence">40</field>
        <field name="privilege_id" ref="privilege_zenlenet"/>
        <field name="comment">客户账单、收款、合同费用条款、95 值、供应商账单、付款、报表。</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('account.group_account_invoice'))]"/>
    </record>
    <record id="group_procurement" model="res.groups">
        <field name="name">采购</field>
        <field name="sequence">50</field>
        <field name="privilege_id" ref="privilege_zenlenet"/>
        <field name="comment">供应商、采购单、设备资产，生成供应商账单。</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('account.group_account_invoice'))]"/>
    </record>
    <record id="group_manager" model="res.groups">
        <field name="name">管理员</field>
        <field name="sequence">90</field>
        <field name="privilege_id" ref="privilege_zenlenet"/>
        <field name="comment">所有岗位的权限，外加删除、系统设置、账号管理。</field>
        <field name="implied_ids" eval="[(4, ref('group_sales')), (4, ref('group_delivery')), (4, ref('group_allocator')), (4, ref('group_pm')), (4, ref('group_service')), (4, ref('group_finance')), (4, ref('group_procurement')), (4, ref('sales_team.group_sale_manager'))]"/>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('zenlenet_ops.group_manager'))]"/>
    </record>
</odoo>
