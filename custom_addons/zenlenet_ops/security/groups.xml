<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_zenlenet" model="ir.module.category">
        <field name="name">尊领运营</field>
        <field name="sequence">1</field>
    </record>
    <record id="group_manager" model="res.groups">
        <field name="name">尊领管理员</field>
        <field name="category_id" ref="module_category_zenlenet"/>
        <field name="comment">可以删除合同、工单、数据中心等记录，普通账号只能新建和修改。</field>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('zenlenet_ops.group_manager'))]"/>
    </record>
</odoo>
