<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="zenlenet_ops.IpamNode">
        <li class="zl-tree-node">
            <div t-attf-class="zl-tree-row #{state.selectedId === node.id ? 'active' : ''}" t-on-click="() => this.select(node.id)">
                <span class="zl-tree-toggle" t-on-click.stop="() => this.toggle(node)">
                    <i t-if="children(node).length" t-attf-class="fa #{isExpanded(node) ? 'fa-caret-down' : 'fa-caret-right'}"/>
                    <i t-else="" class="fa fa-circle-o zl-tree-leaf"/>
                </span>
                <span t-attf-class="zl-dot zl-dot-#{node.status}" t-att-title="prefixStatus(node.status)"/>
                <span class="zl-tree-prefix font-monospace" t-out="node.prefix"/>
                <span class="zl-tree-meta" t-if="node.partner" t-out="node.partner"/>
                <span class="zl-tree-util" t-if="node.utilization" t-out="node.utilization + '%'"/>
            </div>
            <ul t-if="isExpanded(node) and children(node).length" class="zl-tree-children">
                <t t-foreach="children(node)" t-as="child" t-key="child.id">
                    <t t-call="zenlenet_ops.IpamNode"><t t-set="node" t-value="child"/></t>
                </t>
            </ul>
        </li>
    </t>

    <t t-name="zenlenet_ops.Ipam">
        <div class="o_action zl-ipam">
            <aside class="zl-ipam-tree">
                <div class="zl-ipam-tree-head">
                    <input type="search" class="form-control form-control-sm" t-att-value="state.search" t-on-input="onSearch"/>
                    <button class="btn btn-primary btn-sm" t-on-click="() => this.addPrefix(null)" title="录入顶级网段"><i class="fa fa-plus"/></button>
                    <button class="btn btn-secondary btn-sm" t-on-click="openList" title="列表视图"><i class="fa fa-list"/></button>
                </div>
                <ul class="zl-tree">
                    <t t-foreach="regionGroups" t-as="region" t-key="region.name">
                        <li class="zl-tree-group">
                            <div class="zl-tree-row zl-tree-region" t-on-click="() => this.toggleGroup(groupKey(region.name))">
                                <span class="zl-tree-toggle"><i t-attf-class="fa #{isGroupOpen(groupKey(region.name)) ? 'fa-caret-down' : 'fa-caret-right'}"/></span>
                                <i class="fa fa-globe text-muted"/> <span class="fw-bold" t-out="region.name"/>
                                <span class="zl-tree-util" t-out="region.count + ' 段'"/>
                            </div>
                            <ul t-if="isGroupOpen(groupKey(region.name))" class="zl-tree-children">
                                <t t-foreach="region.asns" t-as="asn" t-key="asn.name">
                                    <li class="zl-tree-group">
                                        <div class="zl-tree-row zl-tree-asn" t-on-click="() => this.toggleGroup(groupKey(region.name, asn.name))">
                                            <span class="zl-tree-toggle"><i t-attf-class="fa #{isGroupOpen(groupKey(region.name, asn.name)) ? 'fa-caret-down' : 'fa-caret-right'}"/></span>
                                            <i class="fa fa-random text-muted"/> <span class="font-monospace" t-out="asn.name"/>
                                            <span class="zl-tree-util" t-out="asn.nodes.length + ' 段'"/>
                                        </div>
                                        <ul t-if="isGroupOpen(groupKey(region.name, asn.name))" class="zl-tree-children">
                                            <t t-foreach="asn.nodes" t-as="node" t-key="node.id">
                                                <t t-call="zenlenet_ops.IpamNode"/>
                                            </t>
                                        </ul>
                                    </li>
                                </t>
                            </ul>
                        </li>
                    </t>
                </ul>
            </aside>

            <section class="zl-ipam-main" t-if="state.detail">
                <header class="zl-ipam-head">
                    <div class="zl-ipam-title">
                        <i class="fa fa-sitemap text-primary"/>
                        <span class="font-monospace" t-out="state.detail.prefix"/>
                        <span t-attf-class="badge zl-badge-#{state.detail.status}" t-out="state.detail.status_label"/>
                        <span class="text-muted small" t-if="state.detail.region"><i class="fa fa-globe"/> <t t-out="state.detail.region"/></span>
                        <span class="text-muted small font-monospace" t-if="state.detail.asn">AS<t t-out="state.detail.asn"/></span>
                        <span class="text-muted small" t-if="state.detail.datacenter"><i class="fa fa-building-o"/> <t t-out="state.detail.datacenter"/></span>
                        <span class="text-muted small" t-if="state.detail.partner"><i class="fa fa-user-o"/> <t t-out="state.detail.partner"/></span>
                    </div>
                    <div class="zl-ipam-actions" t-if="state.detail.can_write">
                        <button class="btn btn-primary btn-sm" t-on-click="() => this.addPrefix(state.detail)"><i class="fa fa-plus"/> 添加网段</button>
                        <button class="btn btn-secondary btn-sm" t-on-click="split"><i class="fa fa-scissors"/> 切割</button>
                        <button class="btn btn-secondary btn-sm" t-on-click="() => this.openPrefixTicket('out')"><i class="fa fa-user-plus"/> 整段开通</button>
                        <button class="btn btn-secondary btn-sm" t-on-click="() => this.openPrefixTicket('back')">整段退回</button>
                        <button class="btn btn-secondary btn-sm" t-on-click="() => this.openPrefixTicket('cutover')">整段割接</button>
                        <button class="btn btn-secondary btn-sm" t-on-click="openForm"><i class="fa fa-pencil"/> 修改信息</button>
                        <button t-if="state.detail.netbox_url" class="btn btn-link btn-sm" t-on-click="openNetbox"><i class="fa fa-external-link"/> NetBox</button>
                    </div>
                </header>

                <div class="zl-ipam-body">
                    <div class="zl-ipam-grid-wrap">
                        <div class="zl-ipam-section-title">IP 地址分布</div>
                        <div class="zl-legend">
                            <t t-foreach="statuses" t-as="status" t-key="status[0]">
                                <span><i t-attf-class="zl-cell zl-cell-#{status[0]} zl-legend-dot"/> <t t-out="status[1]"/></span>
                            </t>
                            <span><i class="zl-cell zl-cell-none zl-legend-dot"/> 未登记</span>
                            <span><i class="zl-cell zl-cell-special zl-legend-dot"/> 网络 / 广播</span>
                        </div>
                        <div t-if="state.selection.length" class="zl-bulk">
                            <span>已选 <b t-out="state.selection.length"/> 个地址：</span>
                            <button class="btn btn-sm btn-primary" t-on-click="openBulkAssign"><i class="fa fa-user-plus"/> 挂到开通工单</button>
                            <button class="btn btn-sm btn-outline-primary" t-on-click="() => this.openTicket('back')">退回工单</button>
                            <button class="btn btn-sm btn-outline-primary" t-on-click="() => this.openTicket('cutover')">割接工单</button>
                            <button class="btn btn-sm btn-outline-secondary" t-on-click="openBulkReserve">预分配</button>
                            <button class="btn btn-sm btn-outline-secondary" t-on-click="() => this.bulkStatus('internal')">自用</button>
                            <button class="btn btn-sm btn-outline-secondary" t-on-click="() => this.bulkStatus('free')">取消预留</button>
                            <button class="btn btn-sm btn-link" t-on-click="clearSelection">取消选择</button>
                        </div>
                        <div t-if="state.bulkReserve" class="zl-bulk-assign">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <b>把 <t t-out="state.selection.length"/> 个地址预分配给谁</b>
                                <button class="btn btn-sm btn-link" t-on-click="closeBulkReserve"><i class="fa fa-times"/></button>
                            </div>
                            <input type="text" class="form-control form-control-sm" t-att-value="state.bulkReserve.partner_name" t-on-input="searchBulkCustomers"/>
                            <ul t-if="state.bulkCustomers.length" class="zl-choices">
                                <li t-foreach="state.bulkCustomers" t-as="customer" t-key="customer.id" t-on-click="() => this.pickBulkCustomer(customer)" t-out="customer.name"/>
                            </ul>
                            <div t-if="state.bulkReserve.partner_id" class="small mt-2">留给 <b t-out="state.bulkReserve.partner_name"/></div>
                            <div class="d-flex justify-content-end gap-2 mt-2">
                                <button class="btn btn-sm btn-secondary" t-on-click="closeBulkReserve">取消</button>
                                <button class="btn btn-sm btn-primary" t-on-click="confirmBulkReserve"><i class="fa fa-check"/> 确认预分配</button>
                            </div>
                        </div>
                        <div t-if="state.bulkAssign" class="zl-bulk-assign">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <b>把 <t t-out="state.selection.length"/> 个地址分配出去</b>
                                <button class="btn btn-sm btn-link" t-on-click="closeBulkAssign"><i class="fa fa-times"/></button>
                            </div>
                            <ul class="zl-flow-list">
                                <li t-foreach="state.pendingFlows" t-as="flow" t-key="flow.id" t-attf-class="#{state.bulkAssign.flow_id === flow.id ? 'active' : ''}" t-on-click="() => this.pickFlow(flow)">
                                    <span class="font-monospace fw-bold" t-out="flow.name"/> <span t-out="flow.partner"/>
                                    <span class="text-muted small"> · <t t-out="flow.order"/> <t t-if="flow.datacenter">· <t t-out="flow.datacenter"/></t> · 待分配 <t t-out="flow.pending"/></span>
                                </li>
                            </ul>
                            <input type="text" class="form-control form-control-sm mt-2" t-model="state.bulkAssign.usage"/>
                            <div class="d-flex justify-content-end gap-2 mt-2">
                                <button class="btn btn-sm btn-secondary" t-on-click="() => this.openTicket('out')">先开一张开通工单</button>
                                <button class="btn btn-sm btn-secondary" t-on-click="closeBulkAssign">取消</button>
                                <button class="btn btn-sm btn-primary" t-on-click="confirmBulkAssign"><i class="fa fa-check"/> 挂到这张工单</button>
                            </div>
                        </div>
                        <t t-if="state.detail.blocks.length">
                            <div t-foreach="state.detail.blocks" t-as="block" t-key="block.prefix" class="zl-block">
                                <div class="zl-block-title d-flex justify-content-between">
                                    <span><i class="fa fa-angle-down"/> <span class="font-monospace" t-out="block.label"/> <span class="text-muted small">（<t t-out="block.cells.length"/> 个 · 已用 <t t-out="block.used"/>）</span></span>
                                    <button class="btn btn-sm btn-link p-0" t-on-click="() => this.selectAllFree(block)">选中全部空闲</button>
                                </div>
                                <div class="zl-grid" t-on-mouseup="(ev) => this.onGridUp(block, ev)" t-on-mouseleave="() => this.onGridUp(block, {})">
                                    <t t-foreach="block.cells" t-as="cell" t-key="cell.ip">
                                        <span t-att-class="cellClass(cell, block, cell_index)" t-att-title="cellTitle(cell)" t-on-mousedown="(ev) => this.onCellDown(block, cell_index, cell, ev)" t-on-mouseenter="() => this.onCellEnter(block, cell_index)" t-out="'.' + cell.last"/>
                                    </t>
                                </div>
                            </div>
                        </t>

                        <div class="zl-ipam-section-title mt-3">下级网段（<t t-out="state.detail.children.length"/>）</div>
                        <table class="table table-sm zl-children" t-if="state.detail.children.length">
                            <thead><tr><th>网段</th><th>状态</th><th>分配给</th><th class="text-end">容量</th><th class="text-end">已分配</th><th style="width: 160px;">使用率</th><th>说明</th></tr></thead>
                            <tbody>
                                <tr t-foreach="state.detail.children" t-as="child" t-key="child.id" t-on-click="() => this.select(child.id)" class="zl-child-row">
                                    <td class="font-monospace" t-out="child.prefix"/>
                                    <td><span t-attf-class="badge zl-badge-#{child.status}" t-out="prefixStatus(child.status)"/></td>
                                    <td t-out="child.partner"/>
                                    <td class="text-end" t-out="child.size"/>
                                    <td class="text-end" t-out="child.allocated"/>
                                    <td><div class="progress" style="height: 8px;"><div class="progress-bar" t-attf-style="width: #{child.utilization}%"/></div></td>
                                    <td class="text-muted small" t-out="child.description"/>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <aside class="zl-ipam-facts">
                        <div class="zl-ipam-section-title">基本信息</div>
                        <dl>
                            <dt>地区</dt><dd t-out="state.detail.region || '—'"/>
                            <dt>AS 号</dt><dd class="font-monospace" t-out="state.detail.asn ? 'AS' + state.detail.asn : '—'"/>
                            <dt>IP 段</dt><dd><a href="#" class="font-monospace" t-on-click.prevent="() => this.select(state.detail.top_id)" t-out="state.detail.top"/></dd>
                            <dt>IP 小段</dt><dd class="font-monospace" t-out="state.detail.prefix"/>
                            <dt>CIDR</dt><dd class="font-monospace" t-out="state.detail.prefix"/>
                            <dt>协议</dt><dd t-out="state.detail.family === '6' ? 'IPv6' : 'IPv4'"/>
                            <dt>容量</dt><dd t-out="state.detail.size_display"/>
                            <dt>掩码</dt><dd class="font-monospace" t-out="state.detail.netmask"/>
                            <dt>起始 IP</dt><dd class="font-monospace" t-out="state.detail.first_ip"/>
                            <dt>结束 IP</dt><dd class="font-monospace" t-out="state.detail.last_ip"/>
                            <dt>IP 占用</dt><dd>已用 <b t-out="state.detail.used"/> / <t t-out="state.detail.size_display"/></dd>
                        </dl>
                        <div t-if="Object.keys(state.detail.counts).length" class="zl-counts">
                            <span t-foreach="Object.entries(state.detail.counts)" t-as="entry" t-key="entry[0]"><t t-out="entry[0]"/> <b t-out="entry[1]"/></span>
                        </div>
                        <div class="zl-ipam-section-title mt-3">管理信息</div>
                        <dl>
                            <dt>状态</dt><dd t-out="state.detail.status_label"/>
                            <dt>上级网段</dt><dd><a t-if="state.detail.parent_id" href="#" class="font-monospace" t-on-click.prevent="() => this.select(state.detail.parent_id)" t-out="state.detail.parent"/><span t-else="">—</span></dd>
                            <dt>分配给</dt><dd t-out="state.detail.partner || '—'"/>
                            <dt>预分配给</dt>
                            <dd>
                                <t t-if="state.detail.reserved_for.length">
                                    <div t-foreach="state.detail.reserved_for" t-as="row" t-key="row.partner"><t t-out="row.partner"/> · <t t-out="row.count"/> 个</div>
                                </t>
                                <span t-else="">—</span>
                            </dd>
                            <dt>数据中心</dt><dd t-out="state.detail.datacenter || '—'"/>
                            <dt>用途角色</dt><dd t-out="state.detail.role || '—'"/>
                            <dt>VLAN</dt><dd t-out="state.detail.vlan || '—'"/>
                            <dt>说明</dt><dd t-out="state.detail.description || '—'"/>
                            <dt>NetBox</dt><dd><t t-if="state.detail.netbox_id">#<t t-out="state.detail.netbox_id"/> · <t t-out="state.detail.netbox_synced"/></t><t t-else="">未同步</t></dd>
                            <dt>创建</dt><dd t-out="state.detail.create_date"/>
                        </dl>
                    </aside>
                </div>

                <div t-if="state.cell" class="zl-cell-pop">
                    <div class="zl-cell-pop-head">
                        <span class="font-monospace fw-bold" t-out="state.cell.ip"/>
                        <button class="btn btn-sm btn-link" t-on-click="closeCell"><i class="fa fa-times"/></button>
                    </div>
                    <label>状态</label>
                    <select t-if="!ticketLocked" class="form-select form-select-sm" t-model="state.cellForm.status">
                        <option value="free">未分配</option>
                        <option value="reserved">预分配</option>
                        <option value="internal">自用</option>
                    </select>
                    <label><t t-if="state.cellForm.status === 'reserved'">预分配给</t><t t-else="">分配给</t></label>
                    <input type="text" class="form-control form-control-sm" t-att-value="state.cellForm.partner_name" t-on-input="(ev) => this.searchCustomers(ev, 'cell')"/>
                    <ul t-if="state.customers.length" class="zl-choices">
                        <li t-foreach="state.customers" t-as="customer" t-key="customer.id" t-on-click="() => this.pickCustomer(customer)" t-out="customer.name"/>
                    </ul>
                    <label>用途</label>
                    <input type="text" class="form-control form-control-sm" t-model="state.cellForm.usage"/>
                    <div class="d-flex justify-content-end gap-2 mt-2">
                        <button class="btn btn-sm btn-secondary" t-on-click="closeCell">取消</button>
                        <button class="btn btn-sm btn-primary" t-on-click="saveCell">保存</button>
                    </div>
                </div>
            </section>
            <section class="zl-ipam-main d-flex align-items-center justify-content-center text-muted" t-else="">
                <t t-if="state.loading">加载中…</t>
            </section>
        </div>
    </t>
</templates>
