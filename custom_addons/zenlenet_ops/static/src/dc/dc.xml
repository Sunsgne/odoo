<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="zenlenet_ops.Datacenter">
        <div class="o_action zl-dc">
            <aside class="zl-dc-tree">
                <div class="zl-dc-tree-head">
                    <input type="search" class="form-control form-control-sm" t-att-value="state.search" t-on-input="onSearch"/>
                    <button class="btn btn-primary btn-sm" t-on-click="() => this.editSite(false)" title="新机房"><i class="fa fa-plus"/></button>
                </div>
                <ul class="zl-dc-regions">
                    <li t-foreach="regions" t-as="region" t-key="region.name">
                        <div class="zl-dc-region"><i class="fa fa-globe"/> <t t-out="region.name"/> <span t-out="region.sites.length"/></div>
                        <ul>
                            <li t-foreach="region.sites" t-as="site" t-key="site.id" t-att-data-site-id="site.id" t-att-class="state.selectedId === site.id ? 'active' : ''" t-on-click="() => this.select(site.id)">
                                <span t-attf-class="zl-dc-dot zl-dc-dot-#{site.state}"/>
                                <span class="zl-dc-name" t-out="site.name"/>
                                <span class="zl-dc-free" t-if="site.sellable_prefixes or site.sellable_lines or site.sellable_vms">可售 <t t-out="site.sellable_prefixes"/> 段 · <t t-out="site.sellable_lines"/> 线 · <t t-out="site.sellable_vms"/> 机</span>
                            </li>
                        </ul>
                    </li>
                </ul>
                <button t-if="state.loose" type="button" t-attf-class="zl-dc-loose {{ state.selectedId === 0 ? 'active' : '' }}" t-on-click="() => this.select(0)">未挂机房 <t t-out="state.loose"/></button>
            </aside>

            <section class="zl-dc-main" t-if="state.detail">
                <header class="zl-dc-head">
                    <div>
                        <div class="zl-dc-title">
                            <span t-out="state.detail.name"/>
                            <span t-attf-class="badge zl-dc-badge-#{state.detail.state}" t-out="state.detail.state_label"/>
                        </div>
                        <div class="text-muted small">
                            <t t-if="state.detail.region"><t t-out="state.detail.region"/></t>
                            <t t-if="state.detail.facility"> · <t t-out="state.detail.facility"/></t>
                            <t t-if="state.detail.asn"> · AS<t t-out="state.detail.asn"/></t>
                        </div>
                        <div class="zl-dc-summary">可售地址段 <b t-out="state.detail.sellable_prefixes"/> · 可售线路 <b t-out="state.detail.sellable_lines"/> · 可售云主机 <b t-out="state.detail.sellable_vms"/></div>
                    </div>
                    <div class="zl-dc-actions" t-if="state.detail.can_write &amp;&amp; !state.detail.loose">
                        <button class="btn btn-primary btn-sm" t-on-click="() => this.openTicket('in')">资源进库</button>
                        <button class="btn btn-secondary btn-sm" t-on-click="() => this.openTicket('back')">退回</button>
                        <button class="btn btn-secondary btn-sm" t-on-click="() => this.openTicket('cutover')">割接</button>
                        <button class="btn btn-secondary btn-sm" t-on-click="() => this.editSite(state.detail.id)"><i class="fa fa-pencil"/> 改机房资料</button>
                        <button t-if="state.detail.netbox_url" class="btn btn-link btn-sm" t-on-click="openNetbox">NetBox</button>
                    </div>
                </header>

                <div class="zl-dc-body">
                    <div class="zl-dc-work">
                        <div class="zl-dc-filters">
                            <span class="text-muted">看</span>
                            <button t-att-class="state.filter === 'free' ? 'btn btn-sm btn-primary' : 'btn btn-sm btn-outline-secondary'" t-on-click="() => this.setFilter('free')">可售</button>
                            <button t-att-class="state.filter === 'sold' ? 'btn btn-sm btn-primary' : 'btn btn-sm btn-outline-secondary'" t-on-click="() => this.setFilter('sold')">已卖出</button>
                            <button t-att-class="state.filter === 'all' ? 'btn btn-sm btn-primary' : 'btn btn-sm btn-outline-secondary'" t-on-click="() => this.setFilter('all')">全部</button>
                        </div>

                        <div class="zl-dc-section-row">
                            <div class="zl-dc-section">专线</div>
                            <button t-if="state.detail.can_write" class="btn btn-link btn-sm" t-on-click="() => this.addLine('pl')">加一条专线</button>
                        </div>
                        <table class="table table-sm zl-dc-table" t-if="privateLines.length">
                            <thead><tr><th>专线</th><th>带宽</th><th>A 端</th><th>Z 端</th><th>客户</th></tr></thead>
                            <tbody>
                                <tr t-foreach="privateLines" t-as="row" t-key="row.id" t-att-class="isPicked('line', row.id) ? 'active' : ''" t-on-click="() => this.pick('line', row)">
                                    <td t-out="row.name"/>
                                    <td t-out="row.bandwidth || '—'"/>
                                    <td t-out="row.a_end || '—'"/>
                                    <td t-out="row.z_end || '—'"/>
                                    <td><t t-if="row.partner" t-out="row.partner"/><span t-else="" class="text-success">可售</span></td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="zl-dc-section-row">
                            <div class="zl-dc-section">SD-WAN</div>
                            <button t-if="state.detail.can_write" class="btn btn-link btn-sm" t-on-click="() => this.addLine('sdwan')">加一条 SD-WAN</button>
                        </div>
                        <table class="table table-sm zl-dc-table" t-if="sdwanLines.length">
                            <thead><tr><th>接入</th><th>地区</th><th>带宽</th><th>客户</th></tr></thead>
                            <tbody>
                                <tr t-foreach="sdwanLines" t-as="row" t-key="row.id" t-att-class="isPicked('line', row.id) ? 'active' : ''" t-on-click="() => this.pick('line', row)">
                                    <td t-out="row.name"/>
                                    <td t-out="row.region || '—'"/>
                                    <td t-out="row.bandwidth || '—'"/>
                                    <td><t t-if="row.partner" t-out="row.partner"/><span t-else="" class="text-success">可售</span></td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="zl-dc-section-row">
                            <div class="zl-dc-section">VXLAN</div>
                            <button t-if="state.detail.can_write" class="btn btn-link btn-sm" t-on-click="() => this.addLine('vxlan')">加一条 VXLAN</button>
                        </div>
                        <table class="table table-sm zl-dc-table" t-if="vxlanLines.length">
                            <thead><tr><th>链路</th><th>带宽</th><th>A 端</th><th>Z 端</th><th>客户</th></tr></thead>
                            <tbody>
                                <tr t-foreach="vxlanLines" t-as="row" t-key="row.id" t-att-class="isPicked('line', row.id) ? 'active' : ''" t-on-click="() => this.pick('line', row)">
                                    <td t-out="row.name"/>
                                    <td t-out="row.bandwidth || '—'"/>
                                    <td t-out="row.a_end || '—'"/>
                                    <td t-out="row.z_end || '—'"/>
                                    <td><t t-if="row.partner" t-out="row.partner"/><span t-else="" class="text-success">可售</span></td>
                                </tr>
                            </tbody>
                        </table>

                        <t t-if="otherLines.length">
                            <div class="zl-dc-section">其他线路</div>
                            <table class="table table-sm zl-dc-table">
                                <thead><tr><th>线路</th><th>带宽</th><th>A 端</th><th>Z 端</th><th>客户</th></tr></thead>
                                <tbody>
                                    <tr t-foreach="otherLines" t-as="row" t-key="row.id" t-att-class="isPicked('line', row.id) ? 'active' : ''" t-on-click="() => this.pick('line', row)">
                                        <td t-out="row.name"/>
                                        <td t-out="row.bandwidth || '—'"/>
                                        <td t-out="row.a_end || '—'"/>
                                        <td t-out="row.z_end || '—'"/>
                                        <td><t t-if="row.partner" t-out="row.partner"/><span t-else="" class="text-success">可售</span></td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>

                        <div class="zl-dc-section-row">
                            <div class="zl-dc-section">物理机</div>
                            <button t-if="state.detail.can_write &amp;&amp; state.detail.id" class="btn btn-link btn-sm" t-on-click="() => this.openRecord('zenlenet.device', false, '物理机', {default_datacenter_id: this.state.selectedId})">加一台物理机</button>
                        </div>
                        <table class="table table-sm zl-dc-table" t-if="devices.length">
                            <thead><tr><th>设备</th><th>角色</th><th>状态</th><th class="text-end">云主机</th></tr></thead>
                            <tbody>
                                <tr t-foreach="devices" t-as="row" t-key="row.id" t-att-class="isPicked('device', row.id) ? 'active' : ''" t-on-click="() => this.pick('device', row)">
                                    <td t-out="row.name"/>
                                    <td t-out="row.role || '—'"/>
                                    <td t-out="row.status_label"/>
                                    <td class="text-end" t-out="row.vms"/>
                                </tr>
                            </tbody>
                        </table>

                        <div class="zl-dc-section-row">
                            <div class="zl-dc-section">云主机</div>
                            <button t-if="state.detail.can_write &amp;&amp; state.detail.id" class="btn btn-link btn-sm" t-on-click="() => this.openRecord('zenlenet.vm', false, '云主机', {default_datacenter_id: this.state.selectedId})">加一台云主机</button>
                        </div>
                        <table class="table table-sm zl-dc-table" t-if="vms.length">
                            <thead><tr><th>云主机</th><th>物理机</th><th>IP</th><th>带宽</th><th>客户</th></tr></thead>
                            <tbody>
                                <tr t-foreach="vms" t-as="row" t-key="row.id" t-att-class="isPicked('vm', row.id) ? 'active' : ''" t-on-click="() => this.pick('vm', row)">
                                    <td t-out="row.name"/>
                                    <td t-out="row.device || '—'"/>
                                    <td class="font-monospace" t-out="row.ip || '—'"/>
                                    <td t-out="row.bandwidth || '—'"/>
                                    <td><t t-if="row.partner" t-out="row.partner"/><span t-else="" class="text-success">可售</span></td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="zl-dc-section">地址段</div>
                        <table class="table table-sm zl-dc-table" t-if="prefixes.length">
                            <thead><tr><th>网段</th><th>状态</th><th>客户</th><th class="text-end">容量</th><th class="text-end">空闲</th></tr></thead>
                            <tbody>
                                <tr t-foreach="prefixes" t-as="row" t-key="row.id" t-att-class="isPicked('prefix', row.id) ? 'active' : ''" t-on-click="() => this.pick('prefix', row)">
                                    <td class="font-monospace" t-out="row.prefix"/>
                                    <td t-out="prefixStatus(row.status)"/>
                                    <td><t t-if="row.partner" t-out="row.partner"/><span t-else="" class="text-success">可售</span></td>
                                    <td class="text-end" t-out="row.size"/>
                                    <td class="text-end" t-out="row.free"/>
                                </tr>
                            </tbody>
                        </table>

                    </div>

                    <aside class="zl-dc-facts">
                        <t t-if="pickedPrefix">
                            <div class="zl-dc-section">这段地址</div>
                            <div class="font-monospace fw-bold mb-2" t-out="pickedPrefix.prefix"/>
                            <dl>
                                <dt>状态</dt><dd t-out="prefixStatus(pickedPrefix.status)"/>
                                <dt>客户</dt><dd><t t-if="pickedPrefix.partner" t-out="pickedPrefix.partner"/><span t-else="">可售</span></dd>
                                <dt>容量</dt><dd t-out="pickedPrefix.size"/>
                                <dt>已用</dt><dd t-out="pickedPrefix.used"/>
                                <dt>空闲</dt><dd t-out="pickedPrefix.free"/>
                                <dt>上级</dt><dd class="font-monospace" t-out="pickedPrefix.parent || '—'"/>
                                <dt>说明</dt><dd t-out="pickedPrefix.description || '—'"/>
                            </dl>
                            <div class="zl-dc-section mt-3" t-if="childrenOf(pickedPrefix.id).length">切出来的小段</div>
                            <ul class="zl-dc-children" t-if="childrenOf(pickedPrefix.id).length">
                                <li t-foreach="childrenOf(pickedPrefix.id)" t-as="child" t-key="child.id">
                                    <span class="font-monospace" t-out="child.prefix"/>
                                    <span t-if="child.partner" t-out="child.partner"/>
                                    <span t-else="" class="text-success">可售</span>
                                </li>
                            </ul>
                        </t>
                        <t t-elif="pickedLine">
                            <div class="zl-dc-section" t-out="pickedLine.kind_label || '这条线路'"/>
                            <div class="fw-bold mb-2" t-out="pickedLine.name"/>
                            <dl>
                                <dt>状态</dt><dd t-out="pickedLine.status_label"/>
                                <dt>客户</dt><dd><t t-if="pickedLine.partner" t-out="pickedLine.partner"/><span t-else="">可售</span></dd>
                                <dt>带宽</dt><dd t-out="pickedLine.bandwidth || '—'"/></dl>
                            <dl t-if="pickedLine.kind === 'sdwan'">
                                <dt>地区</dt><dd t-out="pickedLine.region || '—'"/>
                            </dl>
                            <dl t-else="">
                                <dt>A 端机房</dt><dd t-out="pickedLine.a_site || '—'"/>
                                <dt>A 端设备</dt><dd t-out="pickedLine.a_device || '—'"/>
                                <dt>A 端端口</dt><dd t-out="pickedLine.a_port || '—'"/>
                                <dt>A 端 VLAN</dt><dd t-out="pickedLine.a_vlan || '—'"/>
                                <dt>Z 端机房</dt><dd t-out="pickedLine.z_site || '—'"/>
                                <dt>Z 端设备</dt><dd t-out="pickedLine.z_device || '—'"/>
                                <dt>Z 端端口</dt><dd t-out="pickedLine.z_port || '—'"/>
                                <dt>Z 端 VLAN</dt><dd t-out="pickedLine.z_vlan || '—'"/>
                            </dl>
                            <dl>
                                <dt>供应商</dt><dd t-out="pickedLine.supplier || '—'"/>
                                <dt>用途</dt><dd t-out="pickedLine.purpose || '—'"/>
                            </dl>
                            <button class="btn btn-secondary btn-sm mt-2" t-on-click="() => this.editLine(pickedLine.id)">改绑定</button>
                        </t>
                        <t t-elif="pickedVm">
                            <div class="zl-dc-section">这台云主机</div>
                            <div class="fw-bold mb-2" t-out="pickedVm.name"/>
                            <dl>
                                <dt>机房</dt><dd t-out="state.detail.name"/>
                                <dt>物理机</dt><dd t-out="pickedVm.device || '—'"/>
                                <dt>IP</dt><dd class="font-monospace" t-out="pickedVm.ip || '—'"/>
                                <dt>带宽</dt><dd t-out="pickedVm.bandwidth || '—'"/>
                                <dt>状态</dt><dd t-out="pickedVm.status_label"/>
                                <dt>客户</dt><dd><t t-if="pickedVm.partner" t-out="pickedVm.partner"/><span t-else="">可售</span></dd>
                            </dl>
                            <button class="btn btn-secondary btn-sm mt-2" t-on-click="() => this.openRecord('zenlenet.vm', pickedVm.id, '云主机')">改绑定</button>
                        </t>
                        <t t-elif="pickedDevice">
                            <div class="zl-dc-section">这台物理机</div>
                            <div class="fw-bold mb-2" t-out="pickedDevice.name"/>
                            <dl>
                                <dt>机房</dt><dd t-out="state.detail.name"/>
                                <dt>角色</dt><dd t-out="pickedDevice.role || '—'"/>
                                <dt>状态</dt><dd t-out="pickedDevice.status_label"/>
                                <dt>云主机</dt><dd t-out="pickedDevice.vms"/>
                            </dl>
                            <button class="btn btn-secondary btn-sm mt-2" t-on-click="() => this.openRecord('zenlenet.device', pickedDevice.id, '物理机')">改这台物理机</button>
                        </t>
                        <t t-else="">
                            <div class="zl-dc-section">机房</div>
                            <dl>
                                <dt>状态</dt><dd t-out="state.detail.state_label"/>
                                <dt>地区</dt><dd t-out="state.detail.region || '—'"/>
                                <dt>设施</dt><dd t-out="state.detail.facility || '—'"/>
                                <dt>AS</dt><dd t-out="state.detail.asn ? 'AS' + state.detail.asn : '—'"/>
                                <dt>城市</dt><dd t-out="state.detail.city || '—'"/>
                                <dt>地址</dt><dd t-out="state.detail.address || '—'"/>
                                <dt>供应商</dt><dd t-out="state.detail.supplier || '—'"/>
                                <dt>联系人</dt><dd t-out="state.detail.contact || '—'"/>
                                <dt>电话</dt><dd t-out="state.detail.phone || '—'"/>
                                <dt>备注</dt><dd t-out="state.detail.note || '—'"/>
                            </dl>
                        </t>
                    </aside>
                </div>
            </section>
            <section class="zl-dc-main d-flex align-items-center justify-content-center text-muted" t-else="">
                <t t-if="state.loading">加载中…</t>
            </section>
        </div>
    </t>
</templates>
